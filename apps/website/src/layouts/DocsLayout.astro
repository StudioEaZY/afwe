---
// DocsLayout.astro - Master Layout with Delta + Cartography aesthetics
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeSection?: string;
  headings?: { depth: number; slug: string; text: string }[];
  wide?: boolean;
}

const {
  title,
  description = "AFWE — Architecture-First Workspace Engine. Your code. Its memory. Its rules.",
  activeSection = "concepts",
  headings = [],
  wide = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — AFWE ReBorn</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet">
  <script is:inline>
    // Theme initialization
    (function () {
      try {
        const stored = localStorage.getItem('theme');
        const dark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    })();
  </script>
</head>

<body class="min-h-screen bg-parchment-50 dark:bg-obsidian-950 text-parchment-900 dark:text-obsidian-100 font-sans relative selection:bg-emerald-500/30 selection:text-emerald-950 dark:selection:text-emerald-200">
  <!-- Accessible Skip To Content -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-emerald-700 focus:text-white focus:rounded-lg focus:shadow-xl font-mono text-xs font-bold">
    Skip to main content
  </a>
  <!-- Subtle Background Hatch & Noise Grid -->
  <div class="fixed inset-0 pointer-events-none z-0 opacity-40 dark:opacity-20 bg-grid-dots" aria-hidden="true"></div>

  <!-- Top Multi-color Brand Accent Strip -->
  <div class="grid h-1.5 w-full grid-cols-8 fixed top-0 inset-x-0 z-50">
    <span class="col-span-2 bg-emerald-500"></span>
    <span class="col-span-2 bg-cyan-500"></span>
    <span class="col-span-2 bg-indigo-500"></span>
    <span class="col-span-1 bg-amber-500"></span>
    <span class="col-span-1 bg-neutral-800"></span>
  </div>

  <!-- Master Top Navigation Bar -->
  <header class="sticky top-1.5 z-40 w-full border-b border-parchment-400 dark:border-obsidian-700 bg-parchment-100/90 dark:bg-obsidian-950/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
      <!-- Left: Logo & Branding -->
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <!-- Clover Cluster Icon -->
          <svg class="size-6 text-emerald-600 dark:text-emerald-400 group-hover:rotate-12 transition-transform" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="5" r="3" />
            <circle cx="12" cy="19" r="3" />
            <circle cx="5" cy="12" r="3" />
            <circle cx="19" cy="12" r="3" />
            <circle cx="12" cy="12" r="1.5" />
          </svg>
          <span class="font-bold font-mono tracking-tight text-lg text-parchment-900 dark:text-white">AFWE</span>
        </a>
        <div class="hidden sm:flex items-center gap-2">
          <span class="rounded bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-[10px] font-mono px-2 py-0.5 border border-emerald-500/30 font-semibold">
            ReBorn v0.2.0
          </span>
          <span class="text-xs text-parchment-600 dark:text-obsidian-400 hidden md:inline">
            Your code. Its memory. Its rules.
          </span>
        </div>
      </div>

      <!-- Center: Health Pill & Search Trigger -->
      <div class="flex items-center gap-3">
        <!-- Health Pill -->
        <a href="/docs/concepts/core-concepts#first-screen" class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/5 text-emerald-700 dark:text-emerald-400 text-xs font-mono hover:bg-emerald-500/10 transition-colors">
          <span class="size-2 rounded-full bg-afwe-commit"></span>
          <span>Everything balances • 3 pins</span>
        </a>

        <!-- Search Button (Cmd+K) -->
        <button data-open-search class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-parchment-400 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-850/80 hover:border-parchment-500 dark:hover:border-obsidian-600 text-xs font-mono text-parchment-600 dark:text-obsidian-400 transition-all shadow-sm">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="hidden sm:inline">Search docs & concepts...</span>
          <span class="sm:hidden">Search</span>
          <kbd class="hidden md:inline-block rounded px-1.5 py-0.5 text-[10px] bg-parchment-200 dark:bg-obsidian-800 text-parchment-700 dark:text-obsidian-300 border border-parchment-300 dark:border-obsidian-700">⌘K</kbd>
        </button>
      </div>

      <!-- Right: Links, Persona Toggle, Theme Toggle -->
      <div class="flex items-center gap-3">
        <!-- Persona Switcher -->
        <div class="hidden sm:flex rounded-lg border border-parchment-400 dark:border-obsidian-700 p-0.5 bg-parchment-200/60 dark:bg-obsidian-900 text-[11px] font-mono">
          <button id="persona-founder" class="px-2 py-0.5 rounded text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
            Product
          </button>
          <button id="persona-engineer" class="px-2 py-0.5 rounded bg-white dark:bg-obsidian-800 font-bold shadow-xs text-parchment-900 dark:text-white transition-colors">
            Structure
          </button>
        </div>

        <!-- Theme Switcher -->
        <button id="theme-toggle" title="Toggle theme" class="p-1.5 rounded-lg border border-parchment-400 dark:border-obsidian-700 hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-700 dark:text-obsidian-300 transition-colors">
          <svg class="size-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="size-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- GitHub Link -->
        <a href="https://github.com/StudioEaZY/afwe" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-lg border border-parchment-400 dark:border-obsidian-700 hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-700 dark:text-obsidian-300 transition-colors" title="View GitHub Repository">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative z-10">
    <div class="flex gap-8">
      <!-- Left Navigation Sidebar -->
      <aside class="w-64 shrink-0 hidden lg:block sticky top-20 self-start max-h-[calc(100vh-6rem)] overflow-y-auto pr-3 font-mono text-xs">
        <nav class="space-y-6">
          <!-- Overview -->
          <div>
            <div class="text-[11px] font-bold text-parchment-500 dark:text-obsidian-500 uppercase tracking-wider mb-2">Introduction</div>
            <ul class="space-y-1">
              <li>
                <a href="/" class="block px-2.5 py-1.5 rounded hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
                  Overview & Philosophy
                </a>
              </li>
              <li>
                <a href="/docs/getting-started/quick-start" class="block px-2.5 py-1.5 rounded hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
                  Quick Start (5 Min)
                </a>
              </li>
            </ul>
          </div>

          <!-- ReBorn Core Concepts -->
          <div>
            <div class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-2 flex items-center justify-between">
              <span>Core Concepts</span>
              <span class="text-[9px] px-1 py-0.2 rounded bg-emerald-500/10 border border-emerald-500/20">ReBorn</span>
            </div>
            <ul class="space-y-1 border-l-2 border-parchment-300 dark:border-obsidian-800 ml-1 pl-2">
              <li>
                <a href="/docs/concepts/core-concepts#turns" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  1. Turns & The Receipt
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#the-blueprint" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  2. The Blueprint Graph
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#constraints-are-geometry" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  3. Constraints are Geometry
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#tripwires" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  4. Tripwires & BLAKE3
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#calibration" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  5. Probing Guides Rubric
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#explore-mode" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  6. Explore Mode & Judgment
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#timeline-4d" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                  7. 4D Time Dial & Ghosts
                </a>
              </li>
              <li>
                <a href="/docs/concepts/core-concepts#how-they-fit-together" class="block py-1 text-parchment-700 dark:text-obsidian-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">
                  8. Continuous Loop
                </a>
              </li>
            </ul>
          </div>

          <!-- Validators Hub -->
          <div>
            <div class="text-[11px] font-bold text-parchment-500 dark:text-obsidian-500 uppercase tracking-wider mb-2">Guardrails & Claims</div>
            <ul class="space-y-1">
              <li>
                <a href="/docs/validators" class="block px-2.5 py-1.5 rounded hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
                  Validators Hub (Catalog)
                </a>
              </li>
            </ul>
          </div>

          <!-- Reference -->
          <div>
            <div class="text-[11px] font-bold text-parchment-500 dark:text-obsidian-500 uppercase tracking-wider mb-2">Reference</div>
            <ul class="space-y-1">
              <li>
                <a href="/docs/reference/cli" class="block px-2.5 py-1.5 rounded hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
                  CLI Commands
                </a>
              </li>
              <li>
                <a href="/docs/reference/mcp" class="block px-2.5 py-1.5 rounded hover:bg-parchment-200 dark:hover:bg-obsidian-850 text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors">
                  57 MCP Tools
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </aside>

      <!-- Main Article Content -->
      <main id="main-content" class={`flex-1 min-w-0 ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}>
        <slot />
      </main>

      <!-- Right "On This Page" Table of Contents -->
      {headings.length > 0 && (
        <aside class="w-56 shrink-0 hidden xl:block sticky top-20 self-start max-h-[calc(100vh-6rem)] overflow-y-auto pl-4 font-mono text-xs border-l border-parchment-300 dark:border-obsidian-800">
          <div class="text-[11px] font-bold uppercase tracking-wider text-parchment-500 dark:text-obsidian-500 mb-2">On this page</div>
          <ul class="space-y-2">
            {headings.map(h => (
              <li class={h.depth === 3 ? "pl-3 text-[11px]" : ""}>
                <a href={`#${h.slug}`} class="block text-parchment-600 dark:text-obsidian-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors truncate">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </div>

  <!-- Cartographic Topographical Footer -->
  <footer class="mt-20 border-t border-parchment-400 dark:border-obsidian-700 bg-parchment-200/40 dark:bg-obsidian-900/40 py-10 text-xs font-mono">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 border-b border-parchment-300 dark:border-obsidian-800 pb-6 mb-6">
        <div class="flex items-center gap-3">
          <span class="text-base text-emerald-600 dark:text-emerald-400">✦</span>
          <div>
            <div class="font-bold text-parchment-900 dark:text-obsidian-100 font-sans">AFWE · Architecture-First Workspace Engine</div>
            <div class="text-parchment-600 dark:text-obsidian-400 text-[11px]">Not just a map of your code. A record of what it's supposed to be.</div>
          </div>
        </div>

        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2 py-0.5 rounded border border-parchment-400 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-800 text-[10px]">Deterministic</span>
          <span class="px-2 py-0.5 rounded border border-parchment-400 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-800 text-[10px]">Open</span>
          <span class="px-2 py-0.5 rounded border border-parchment-400 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-800 text-[10px]">Agent-friendly</span>
          <span class="px-2 py-0.5 rounded border border-parchment-400 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-800 text-[10px]">Built for real codebases</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-parchment-500 dark:text-obsidian-500 text-[11px]">
        <div>Double-entry bookkeeping for codebases. Rust · Tree-Sitter · AST Scene Graph · BLAKE3.</div>
        <div>AFWE ReBorn Phase 0–4 Architecture.</div>
      </div>
    </div>
  </footer>

  <!-- Search Modal Component -->
  <SearchModal />

  <script>
    // Theme toggle handling
    function setupThemeToggle() {
      const toggle = document.getElementById('theme-toggle');
      if (!toggle) return;
      toggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    }

    // Persona switch simulation
    function setupPersonaToggle() {
      const pFounder = document.getElementById('persona-founder');
      const pEngineer = document.getElementById('persona-engineer');
      if (!pFounder || !pEngineer) return;

      pFounder.addEventListener('click', () => {
        pFounder.className = 'px-2 py-0.5 rounded bg-white dark:bg-obsidian-800 font-bold shadow-xs text-parchment-900 dark:text-white transition-colors';
        pEngineer.className = 'px-2 py-0.5 rounded text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors';
      });

      pEngineer.addEventListener('click', () => {
        pEngineer.className = 'px-2 py-0.5 rounded bg-white dark:bg-obsidian-800 font-bold shadow-xs text-parchment-900 dark:text-white transition-colors';
        pFounder.className = 'px-2 py-0.5 rounded text-parchment-800 dark:text-obsidian-300 hover:text-black dark:hover:text-white transition-colors';
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      setupThemeToggle();
      setupPersonaToggle();
    });
  </script>
</body>
</html>
