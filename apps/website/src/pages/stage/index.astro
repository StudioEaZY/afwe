---
// stage/index.astro - Staged Redesign of AFWE Homepage
import StageLayout from '../../layouts/StageLayout.astro';
import CodebaseBlueprintRadar from '../../components/CodebaseBlueprintRadar.astro';
import { Copy, Check, X, RefreshCw } from '@lucide/astro';

const steps = [
  {
    title: 'Begin: Briefing Pack',
    body: 'Captures a BLAKE3 and AST symbol baseline. Supplies the agent with scoped context: active block pins, living intents, memory records, constraints, and advisory probing guides.',
    cmd: 'afwe turn begin "<prompt>" --target <files>',
  },
  {
    title: 'Assume: Pre-Code Claims',
    body: 'The agent declares intents and verifiable Tree-Sitter AST claims (forbid imports, forbidden patterns, symbol requirements) before modifying code. Pin conflicts trigger immediate REDO.',
    cmd: 'afwe turn assume <turn> --file assumptions.json',
  },
  {
    title: 'Commit: Gated Verification',
    body: 'Attributes changes against baseline, checks for undeclared feature loss, runs comment-blanked AST claims, and commits atomically with an AFWE-Turn receipt trailer.',
    cmd: 'afwe turn commit <turn> --summary "..."',
  },
];

const folderPoints = [
  {
    title: 'No hidden databases',
    lead: 'Inspectable with git diff.',
    body: 'Every turn, pin, constraint, and architectural evolution is a clear YAML diff in your pull requests. Review them like code.',
  },
  {
    title: 'Codebase pin budget',
    lead: 'Prevents rule sprawl.',
    body: 'Pin budgets automatically scale with codebase size. Slider controls keep rules tight so agents do not drown in obsolete constraints.',
  },
  {
    title: 'Feature restoration',
    lead: 'Recover silent feature losses.',
    body: 'When an agent accidentally deletes code 15 prompts later, run <code class="mono text-[0.9em]">afwe timeline restore</code> to execute an automated 3-way merge against the last good turn.',
  },
  {
    title: 'Tripwire materialization',
    lead: 'Enforce in local hooks and CI.',
    body: 'Run <code class="mono text-[0.9em]">afwe materialize --apply</code> to generate chained git pre-commit hooks and GitHub Actions workflows verified against BLAKE3 manifests.',
  },
];
---

<StageLayout
  title="AFWE · Your agent forgets. Your repo shouldn't."
  description="AFWE records what your code is supposed to be, then checks every agent change against that intent. The intent layer for your codebase."
  activeNav="home"
  currentEquivalent="/"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-24 sm:space-y-32">

    <!-- HERO -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      <div class="lg:col-span-5 space-y-7">
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold text-fg leading-[1.06]">
          Your agent forgets. Your repo shouldn’t.
        </h1>

        <p class="text-base sm:text-lg text-fg-2 leading-relaxed max-w-md">
          AFWE records what your code is <em>supposed to be</em>, then checks every agent change against that intent.
          <button
            type="button"
            id="dynamic-hero-tagline"
            class="mt-2 text-left font-semibold text-fg underline decoration-2 underline-offset-4 decoration-[var(--accent)] cursor-pointer inline-flex items-start gap-2 transition-opacity duration-150"
            title="Show another way to describe it"
          >
            <span aria-live="polite">Double-entry bookkeeping for autonomous coding.</span>
            <RefreshCw class="size-4 mt-1 shrink-0 text-accent" aria-hidden="true" />
            <span class="sr-only">Show another description</span>
          </button>
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/docs/getting-started/quick-start" class="btn btn-primary">Install AFWE</a>
          <a href="/docs/concepts/core-concepts" class="btn btn-quiet">Explore the architecture</a>
        </div>

        <div class="max-w-sm">
          <div class="code-panel flex items-center justify-between gap-3 px-4 py-3 mono text-sm">
            <span class="truncate"><span class="text-[#8CA6FF]" aria-hidden="true">$</span> <span id="install-cmd-text">cargo install afwe</span></span>
            <button
              id="copy-install-btn"
              type="button"
              class="p-1.5 rounded text-[#93A0AE] hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
              aria-label="Copy install command"
            >
              <span id="copy-icon-wrap"><Copy class="size-4" /></span>
              <span id="copied-icon-wrap" class="hidden text-xs font-semibold text-[#4ADE80] items-center gap-1" role="status">
                <Check class="size-3.5" /> Copied
              </span>
            </button>
          </div>
          <p class="text-sm text-fg-3 mt-2">Runs 100% locally on your machine. Rust, Tree-Sitter, BLAKE3.</p>
        </div>
      </div>

      <!-- Hero: a turn being rejected -->
      <div class="lg:col-span-7">
        <figure class="code-panel overflow-hidden shadow-xl" aria-label="Example of AFWE rejecting an agent change">
          <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-white/10">
            <span class="mono text-xs sm:text-sm text-[#D7DEE7]">afwe turn commit t0007</span>
            <span class="ledger-verdict inline-flex items-center gap-1.5 text-xs font-semibold text-[#F87171]">
              <X class="size-3.5" aria-hidden="true" /> Rejected
            </span>
          </div>

          <table class="w-full text-left text-[13px] sm:text-sm">
            <thead>
              <tr class="text-[#93A0AE] text-xs">
                <th scope="col" class="font-medium px-4 sm:px-5 py-2.5 w-1/2">Declared before the edit</th>
                <th scope="col" class="font-medium px-4 sm:px-5 py-2.5 w-1/2">Found in the diff</th>
              </tr>
            </thead>
            <tbody class="mono">
              <tr class="ledger-row border-t border-white/10" style="--i:0">
                <td class="px-4 sm:px-5 py-3.5 align-top">forbid import <span class="text-white">axios</span> in src/core</td>
                <td class="px-4 sm:px-5 py-3.5 align-top"><span class="inline-flex items-center gap-1.5 text-[#4ADE80]"><Check class="size-3.5" aria-hidden="true" /> Held</span><span class="block text-[#93A0AE] mt-0.5">no match</span></td>
              </tr>
              <tr class="ledger-row border-t border-white/10" style="--i:1">
                <td class="px-4 sm:px-5 py-3.5 align-top">require symbol <span class="text-white">verify_session</span></td>
                <td class="px-4 sm:px-5 py-3.5 align-top"><span class="inline-flex items-center gap-1.5 text-[#4ADE80]"><Check class="size-3.5" aria-hidden="true" /> Held</span><span class="block text-[#93A0AE] mt-0.5">symbol present</span></td>
              </tr>
              <tr class="ledger-row border-t border-white/10 bg-[#F87171]/10" style="--i:2">
                <td class="px-4 sm:px-5 py-3.5 align-top">pin-auth blocks edits to <span class="text-white">src/auth/session.rs</span></td>
                <td class="px-4 sm:px-5 py-3.5 align-top"><span class="inline-flex items-center gap-1.5 text-[#F87171]"><X class="size-3.5" aria-hidden="true" /> Broken</span><span class="block text-[#93A0AE] mt-0.5">lines 42 to 61 changed</span></td>
              </tr>
              <tr class="ledger-row border-t border-white/10 bg-[#F87171]/10" style="--i:3">
                <td class="px-4 sm:px-5 py-3.5 align-top">no undeclared feature loss</td>
                <td class="px-4 sm:px-5 py-3.5 align-top"><span class="inline-flex items-center gap-1.5 text-[#F87171]"><X class="size-3.5" aria-hidden="true" /> Broken</span><span class="block text-[#93A0AE] mt-0.5"><span class="text-white">export_csv</span> removed</span></td>
              </tr>
            </tbody>
          </table>

          <figcaption class="ledger-row border-t border-white/10 px-4 sm:px-5 py-4 text-sm text-[#D7DEE7]" style="--i:4">
            Commit blocked. The agent redoes the turn, or you run <span class="mono text-white">afwe timeline restore</span>.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- BLUEPRINT -->
    <section class="space-y-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:items-end">
        <div class="md:col-span-8 space-y-3">
          <h2 class="text-3xl sm:text-4xl font-semibold text-fg">See your codebase in context.</h2>
          <p class="text-base text-fg-2 leading-relaxed max-w-2xl">
            Every codebase has an implicit architecture. AFWE parses your repository into an explicit DAG of subsystems, components, AST claims, and non-negotiable boundary constraints.
          </p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/docs/concepts/core-concepts#the-blueprint" class="font-semibold text-accent underline underline-offset-4 decoration-2">Learn how the Blueprint works</a>
        </div>
      </div>
      <CodebaseBlueprintRadar />
    </section>

    <!-- TURN PROTOCOL: a real sequence, so it is numbered -->
    <section class="space-y-8">
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-semibold text-fg">The 3-step turn protocol.</h2>
        <p class="text-base text-fg-2 leading-relaxed">
          AFWE turns replace unsupervised agent edits with a rigorous double-entry protocol: Briefing Pack, Intent Claims, Deterministic Gating.
        </p>
      </div>

      <ol class="border-t border-line-strong">
        {steps.map((s, i) => (
          <li class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-4 py-8 border-b border-line">
            <div class="md:col-span-1 text-4xl font-semibold text-accent leading-none" aria-hidden="true">{i + 1}</div>
            <div class="md:col-span-6 space-y-2">
              <h3 class="text-xl font-semibold text-fg"><span class="sr-only">Step {i + 1}. </span>{s.title}</h3>
              <p class="text-base text-fg-2 leading-relaxed max-w-prose">{s.body}</p>
            </div>
            <div class="md:col-span-5 md:self-center">
              <pre class="code-panel mono text-[13px] px-4 py-3 overflow-x-auto"><code>{s.cmd}</code></pre>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- .AFWE FOLDER -->
    <section class="space-y-8">
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-semibold text-fg">Human-readable. Git-committed. Zero vendor lock-in.</h2>
        <p class="text-base text-fg-2 leading-relaxed">
          AFWE stores architectural knowledge directly inside your repository in .afwe/. It stays with your code, survives tool migrations, and works with every AI coding assistant.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-6 code-panel p-5 mono text-xs sm:text-[13px] shadow-lg overflow-x-auto">
          <div class="flex items-center justify-between gap-4 pb-3 mb-3 border-b border-white/10 text-[#93A0AE]">
            <span>YOUR-REPO/.afwe/</span>
            <span class="text-[#8CA6FF]">format: afwe/2</span>
          </div>
          <pre class="leading-relaxed"><code>.afwe/
├── <span class="text-[#4ADE80]">afwe.yaml</span>            # Engine policy & test commands
├── <span class="text-[#8CA6FF]">blueprint/</span>
│   ├── blueprint.yaml   # Component DAG & boundaries
│   ├── relations.yaml   # Allowed architectural edges
│   └── constraints.yaml # Non-negotiable boundary rules
├── <span class="text-[#4ADE80]">pins/</span>                # Human decisions locked from changes
│   └── pin-auth.yaml    # Block/Confirm/Warn invariants
├── <span class="text-[#8CA6FF]">guardrails/</span>
│   ├── active/          # AST import & pattern tripwires
│   ├── passive/         # Natural language context briefs
│   └── manifest.yaml    # BLAKE3 checksums for CI tamper-check
├── <span class="text-[#4ADE80]">intents/</span>             # Living feature DAGs & revisions
├── <span class="text-[#8CA6FF]">memory/</span>              # Architectural decision records
│   ├── decisions/       # Why trade-offs were chosen
│   └── terminology/     # Project-specific glossary
└── <span class="text-[#4ADE80]">turns/</span>               # Verified turn ledger receipts
    └── t0001.yaml       # Verbatim prompt, claims, git hash</code></pre>
        </div>

        <dl class="lg:col-span-6 border-t border-line-strong">
          {folderPoints.map((p) => (
            <div class="py-5 border-b border-line">
              <dt class="text-lg font-semibold text-fg">{p.title}</dt>
              <dd class="mt-1 text-base text-fg-2 leading-relaxed">
                <strong class="font-semibold text-fg">{p.lead}</strong> <Fragment set:html={p.body} />
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="bg-accent rounded-lg px-6 sm:px-12 py-10 sm:py-14 text-white">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-sm font-semibold opacity-80">Your code. Its memory. Its rules.</p>
          <h2 class="text-3xl sm:text-4xl font-semibold leading-tight text-white">The intent layer for your codebase.</h2>
          <p class="text-base opacity-90 max-w-xl leading-relaxed">
            No cloud dependencies. No mandatory subscriptions. Just clean deterministic Rust governance keeping your agents aligned with your architecture.
          </p>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold pt-1">
            <li class="inline-flex items-center gap-1.5"><Check class="size-4" aria-hidden="true" /> MIT Open Source</li>
            <li class="inline-flex items-center gap-1.5"><Check class="size-4" aria-hidden="true" /> Zero Telemetry</li>
            <li class="inline-flex items-center gap-1.5"><Check class="size-4" aria-hidden="true" /> 57 MCP Tools</li>
          </ul>
        </div>
        <div class="lg:col-span-5 space-y-4 lg:text-right">
          <h3 class="text-xl font-semibold text-white">Install AFWE in your project</h3>
          <p class="text-base opacity-90 leading-relaxed">Set up in minutes and give your agents the context they need to work safely and effectively.</p>
          <a href="/docs/getting-started/quick-start" class="btn btn-on-ink">View quick start</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .ledger-row { opacity: 0; animation: ledger-in .3s ease-out forwards; animation-delay: calc(var(--i) * 450ms + 350ms); }
    .ledger-verdict { opacity: 0; animation: ledger-in .3s ease-out forwards; animation-delay: 2.4s; }
    @keyframes ledger-in { to { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .ledger-row, .ledger-verdict { opacity: 1; animation: none; }
    }
  </style>

  <script>
    const taglines = [
      "Double-entry bookkeeping for autonomous coding.",
      "What Rust did for safer systems, AFWE does for AI coding.",
      "The intent layer that ensures your code matches what it was supposed to be.",
      "Deterministic guardrails that stop architectural drift before commit.",
      "From prompt suggestions to mathematical AST invariants.",
      "What compilers did for type safety, AFWE does for codebase architecture."
    ];

    const taglineEl = document.getElementById('dynamic-hero-tagline');
    if (taglineEl) {
      let currentIndex = Math.floor(Math.random() * taglines.length);
      const textSpan = taglineEl.querySelector('span');
      if (textSpan) textSpan.textContent = taglines[currentIndex];

      taglineEl.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % taglines.length;
        taglineEl.style.opacity = '0';
        setTimeout(() => {
          if (textSpan) textSpan.textContent = taglines[currentIndex];
          taglineEl.style.opacity = '1';
        }, 150);
      });
    }

    const copyBtn = document.getElementById('copy-install-btn');
    const cmdText = document.getElementById('install-cmd-text');
    const copyIconWrap = document.getElementById('copy-icon-wrap');
    const copiedIconWrap = document.getElementById('copied-icon-wrap');

    if (copyBtn && cmdText && copyIconWrap && copiedIconWrap) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cmdText.textContent || 'cargo install afwe');
        copyIconWrap.classList.add('hidden');
        copiedIconWrap.classList.remove('hidden');
        copiedIconWrap.classList.add('inline-flex');
        setTimeout(() => {
          copyIconWrap.classList.remove('hidden');
          copiedIconWrap.classList.add('hidden');
          copiedIconWrap.classList.remove('inline-flex');
        }, 1500);
      });
    }
  </script>
</StageLayout>
