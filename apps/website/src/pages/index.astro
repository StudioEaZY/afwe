---
// index.astro - Official AFWE Homepage
import MarketingLayout from '../layouts/MarketingLayout.astro';
import AfweIsometricHero from '../components/AfweIsometricHero.astro';
import CodebaseBlueprintRadar from '../components/CodebaseBlueprintRadar.astro';
import { Copy, Check, FileText, Code2, ShieldCheck, ArrowRight, Sparkles, RefreshCw } from '@lucide/astro';
---

<MarketingLayout
  title="AFWE · Your agent forgets. Your repo shouldn't."
  description="AFWE records what your code is supposed to be, then checks every agent change against that intent. The intent layer for your codebase."
  activeNav="home"
>
  <div class="space-y-24 sm:space-y-32 py-8 sm:py-16">
    <!-- ========================================================================= -->
    <!-- SECTION 1: HERO SECTION                                                   -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Hero Left Column: Headline, Copy & Quick Install -->
        <div class="lg:col-span-6 space-y-6 text-left">
          <!-- Preheading Tagline -->
          <div class="text-[11px] sm:text-xs font-mono font-bold tracking-[0.2em] text-graphite/70 dark:text-stone-400 uppercase">
            YOUR CODE. ITS MEMORY. ITS RULES.
          </div>

          <!-- Hero Headline (Geometric Sans-Serif, bold, tight tracking) -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-graphite dark:text-white leading-[1.08] tracking-tight">
            Your agent forgets.<br />
            <span class="text-graphite/70 dark:text-stone-400">Your repo shouldn’t.</span>
          </h1>

          <!-- Value Proposition Description with Randomized / Rotatable Context -->
          <p class="text-base sm:text-lg text-graphite/80 dark:text-stone-300 leading-relaxed max-w-xl">
            AFWE records what your code is <em>supposed to be</em>, then checks every agent change against that intent.
            <span class="inline-block mt-1">
              <strong 
                id="dynamic-hero-tagline" 
                class="text-graphite dark:text-white underline decoration-survey-500/40 hover:decoration-survey-600 cursor-pointer transition-opacity duration-300 inline-flex items-center gap-1.5"
                title="Click to explore another architectural perspective"
              >
                <span>Double-entry bookkeeping for autonomous coding.</span>
                <RefreshCw class="size-3.5 text-survey-600 dark:text-survey-light opacity-60 hover:opacity-100 transition-opacity" />
              </strong>
            </span>
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a 
              href="/docs/getting-started/quick-start" 
              class="px-5 py-3 rounded-lg bg-graphite hover:bg-graphite-900 dark:bg-white dark:hover:bg-stone-100 text-white dark:text-graphite font-mono text-xs font-semibold shadow-sm transition-all inline-flex items-center gap-2"
            >
              <span>Install AFWE</span>
              <ArrowRight class="size-3.5" />
            </a>
            <a 
              href="/docs/concepts/core-concepts" 
              class="px-5 py-3 rounded-lg border border-stone-400 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-850 hover:border-graphite dark:hover:border-stone-400 text-graphite dark:text-stone-200 font-mono text-xs font-semibold shadow-xs transition-all"
            >
              Explore the architecture
            </a>
          </div>

          <!-- Quick Install Snippet Box -->
          <div class="max-w-md pt-2">
            <div class="rounded-xl border border-stone-400/70 dark:border-obsidian-700 bg-white/80 dark:bg-obsidian-900 p-3 shadow-xs">
              <div class="flex items-center justify-between gap-3 text-xs font-mono">
                <div class="flex items-center gap-2 text-graphite dark:text-stone-200 truncate">
                  <span class="text-survey-500 font-bold">$</span>
                  <span id="install-cmd-text">cargo install afwe</span>
                </div>
                <div class="flex items-center gap-2">
                  <button 
                    id="copy-install-btn" 
                    class="p-1.5 rounded hover:bg-stone-200 dark:hover:bg-obsidian-800 text-graphite/70 dark:text-stone-400 transition-colors flex items-center justify-center cursor-pointer"
                    title="Copy command"
                    aria-label="Copy install command"
                  >
                    <span id="copy-icon-wrap"><Copy class="size-4" /></span>
                    <span id="copied-icon-wrap" class="hidden text-survey-600 font-bold text-[11px] flex items-center gap-1">
                      <Check class="size-3.5" /> Copied!
                    </span>
                  </button>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono text-graphite/60 dark:text-stone-400 mt-1.5 px-1">
              <span>Runs 100% locally on your machine</span>
              <span class="text-survey-600 dark:text-survey-light font-medium">Rust · Tree-Sitter · BLAKE3</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: 3D Isometric Levitating Plate SVG -->
        <div class="lg:col-span-6 flex justify-center">
          <AfweIsometricHero />
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: THE CODEBASE BLUEPRINT                                         -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-stone-300 dark:border-obsidian-800 pb-6">
        <div class="space-y-2 max-w-2xl">
          <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
            THE CODEBASE BLUEPRINT
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
            See your codebase in context.
          </h2>
          <p class="text-xs sm:text-sm text-graphite/80 dark:text-stone-300 leading-relaxed font-sans">
            Every codebase has an implicit architecture. AFWE parses your repository into an explicit DAG of subsystems, components, AST claims, and non-negotiable boundary constraints.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a 
            href="/docs/concepts/core-concepts#the-blueprint" 
            class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light hover:underline inline-flex items-center gap-1"
          >
            <span>Learn how the Blueprint works</span>
            <ArrowRight class="size-3.5" />
          </a>
        </div>
      </div>

      <!-- Live Codebase Radar Preview Component -->
      <CodebaseBlueprintRadar />
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 3: HOW IT WORKS (THE 3-STEP TURN LOOP)                            -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="border-b border-stone-300 dark:border-obsidian-800 pb-6">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-graphite/70 dark:text-stone-400 uppercase mb-2">
          HOW IT WORKS
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
          The 3-step turn protocol.
        </h2>
        <p class="text-sm sm:text-base text-graphite/80 dark:text-stone-300 mt-1 max-w-2xl leading-relaxed">
          AFWE turns replace unsupervised agent edits with a rigorous double-entry protocol: Briefing Pack ➔ Intent Claims ➔ Deterministic Gating.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1: Begin -->
        <div class="rounded-2xl border border-stone-400/70 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between shadow-xs hover:border-graphite/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="size-7 rounded-full bg-graphite text-white dark:bg-stone-200 dark:text-graphite font-mono text-xs font-bold flex items-center justify-center">
                1
              </span>
              <div class="size-10 rounded-xl bg-stone-200/60 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200">
                <FileText class="size-5" />
              </div>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">1. Begin: Briefing Pack</h3>
              <p class="text-xs text-graphite/80 dark:text-stone-300 leading-relaxed mt-2 font-sans">
                Captures a BLAKE3 and AST symbol baseline. Supplies the agent with scoped context: active block pins, living intents, memory records, constraints, and advisory probing guides.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-stone-300 dark:border-obsidian-800 font-mono text-[11px] text-survey-600 dark:text-survey-light">
            afwe turn begin "&lt;prompt&gt;" --target &lt;files&gt;
          </div>
        </div>

        <!-- Step 2: Assume -->
        <div class="rounded-2xl border border-stone-400/70 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between shadow-xs hover:border-graphite/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="size-7 rounded-full bg-graphite text-white dark:bg-stone-200 dark:text-graphite font-mono text-xs font-bold flex items-center justify-center">
                2
              </span>
              <div class="size-10 rounded-xl bg-stone-200/60 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200">
                <Code2 class="size-5" />
              </div>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">2. Assume: Pre-Code Claims</h3>
              <p class="text-xs text-graphite/80 dark:text-stone-300 leading-relaxed mt-2 font-sans">
                The agent declares intents and verifiable Tree-Sitter AST claims (forbid imports, forbidden patterns, symbol requirements) before modifying code. Pin conflicts trigger immediate REDO.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-stone-300 dark:border-obsidian-800 font-mono text-[11px] text-survey-600 dark:text-survey-light">
            afwe turn assume &lt;turn&gt; --file assumptions.json
          </div>
        </div>

        <!-- Step 3: Commit -->
        <div class="rounded-2xl border border-stone-400/70 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between shadow-xs hover:border-graphite/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="size-7 rounded-full bg-graphite text-white dark:bg-stone-200 dark:text-graphite font-mono text-xs font-bold flex items-center justify-center">
                3
              </span>
              <div class="size-10 rounded-xl bg-stone-200/60 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200">
                <ShieldCheck class="size-5" />
              </div>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">3. Commit: Gated Verification</h3>
              <p class="text-xs text-graphite/80 dark:text-stone-300 leading-relaxed mt-2 font-sans">
                Attributes changes against baseline, checks for undeclared feature loss, runs comment-blanked AST claims, and commits atomically with an AFWE-Turn receipt trailer.
              </p>
            </div>
          </div>
          <div class="mt-6 pt-3 border-t border-stone-300 dark:border-obsidian-800 font-mono text-[11px] text-survey-600 dark:text-survey-light">
            afwe turn commit &lt;turn&gt; --summary "..."
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 4: WHAT LIVES IN .AFWE/ (THE FOLDER IS THE PRODUCT)               -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="border-b border-stone-300 dark:border-obsidian-800 pb-6">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-graphite/70 dark:text-stone-400 uppercase mb-2">
          THE FOLDER IS THE PRODUCT
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
          Human-readable. Git-committed. Zero vendor lock-in.
        </h2>
        <p class="text-sm sm:text-base text-graphite/80 dark:text-stone-300 mt-1 max-w-2xl leading-relaxed">
          AFWE stores architectural knowledge directly inside your repository in .afwe/. It stays with your code, survives tool migrations, and works with every AI coding assistant.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Tree View of .afwe/ -->
        <div class="lg:col-span-5 rounded-2xl border border-stone-400/80 dark:border-obsidian-700 bg-graphite-900 text-stone-200 dark:bg-obsidian-900 p-5 font-mono text-xs shadow-md">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-stone-700 dark:border-obsidian-750 text-stone-400 text-[11px]">
            <span>YOUR-REPO/.afwe/</span>
            <span class="text-survey-light">format: afwe/2</span>
          </div>
          <pre class="leading-relaxed text-[11px] sm:text-xs"><code>.afwe/
├── <span class="text-emerald-400">afwe.yaml</span>            # Engine policy & test commands
├── <span class="text-survey-light">blueprint/</span>
│   ├── blueprint.yaml   # Component DAG & boundaries
│   ├── relations.yaml   # Allowed architectural edges
│   └── constraints.yaml # Non-negotiable boundary rules
├── <span class="text-emerald-400">pins/</span>                # Human decisions locked from changes
│   └── pin-auth.yaml    # Block/Confirm/Warn invariants
├── <span class="text-survey-light">guardrails/</span>
│   ├── active/          # AST import & pattern tripwires
│   ├── passive/         # Natural language context briefs
│   └── manifest.yaml    # BLAKE3 checksums for CI tamper-check
├── <span class="text-emerald-400">intents/</span>             # Living feature DAGs & revisions
├── <span class="text-survey-light">memory/</span>              # Architectural decision records
│   ├── decisions/       # Why trade-offs were chosen
│   └── terminology/     # Project-specific glossary
└── <span class="text-emerald-400">turns/</span>               # Verified turn ledger receipts
    └── t0001.yaml       # Verbatim prompt, claims, git hash</code></pre>
        </div>

        <!-- Right: Why This Matters Grid -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/60 dark:bg-obsidian-850 p-5 space-y-2">
            <div class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light uppercase">No Hidden Databases</div>
            <h4 class="font-bold text-sm text-graphite dark:text-white">Inspectable with Git Diff</h4>
            <p class="text-xs text-graphite/70 dark:text-stone-400 leading-relaxed">
              Every turn, pin, constraint, and architectural evolution is a clear YAML diff in your pull requests. Review them like code.
            </p>
          </div>

          <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/60 dark:bg-obsidian-850 p-5 space-y-2">
            <div class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light uppercase">Codebase Pin Budget</div>
            <h4 class="font-bold text-sm text-graphite dark:text-white">Prevents Rule Sprawl</h4>
            <p class="text-xs text-graphite/70 dark:text-stone-400 leading-relaxed">
              Pin budgets automatically scale with codebase size. Slider controls keep rules tight so agents do not drown in obsolete constraints.
            </p>
          </div>

          <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/60 dark:bg-obsidian-850 p-5 space-y-2">
            <div class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light uppercase">Feature Restoration</div>
            <h4 class="font-bold text-sm text-graphite dark:text-white">Recover Silent Feature Losses</h4>
            <p class="text-xs text-graphite/70 dark:text-stone-400 leading-relaxed">
              When an agent accidentally deletes code 15 prompts later, run <code>afwe timeline restore</code> to execute an automated 3-way merge against the last good turn.
            </p>
          </div>

          <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/60 dark:bg-obsidian-850 p-5 space-y-2">
            <div class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light uppercase">Tripwire Materialization</div>
            <h4 class="font-bold text-sm text-graphite dark:text-white">Enforce in Local Hooks and CI</h4>
            <p class="text-xs text-graphite/70 dark:text-stone-400 leading-relaxed">
              Run <code>afwe materialize --apply</code> to generate chained git pre-commit hooks and GitHub Actions workflows verified against BLAKE3 manifests.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 5: READY TO GET STARTED BANNER                                    -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-stone-400/80 dark:border-obsidian-700 bg-gradient-to-r from-stone-300/40 via-paper to-stone-200/40 dark:from-obsidian-900 dark:via-obsidian-850 dark:to-obsidian-900 overflow-hidden shadow-lg grid grid-cols-1 lg:grid-cols-12">
        <!-- Left: Cartographic City Illustration -->
        <div class="lg:col-span-6 p-8 sm:p-12 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-stone-400/50 dark:border-obsidian-700 relative overflow-hidden">
          <div class="space-y-4 relative z-10">
            <span class="text-xs font-mono font-bold tracking-widest text-survey-600 dark:text-survey-light uppercase">
              LOCAL-FIRST HARNESS
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-graphite dark:text-white">
              The intent layer for your codebase.
            </h2>
            <p class="text-xs sm:text-sm text-graphite/80 dark:text-stone-300 leading-relaxed">
              No cloud dependencies. No mandatory subscriptions. Just clean deterministic Rust governance keeping your agents aligned with your architecture.
            </p>
          </div>

          <div class="pt-6 relative z-10 flex items-center gap-4 text-xs font-mono text-graphite/70 dark:text-stone-400">
            <span class="inline-flex items-center gap-1.5"><Check class="size-3.5 text-survey-600" /> MIT Open Source</span>
            <span class="inline-flex items-center gap-1.5"><Check class="size-3.5 text-survey-600" /> Zero Telemetry</span>
            <span class="inline-flex items-center gap-1.5"><Check class="size-3.5 text-survey-600" /> 57 MCP Tools</span>
          </div>
        </div>

        <!-- Right: Action Callout Card -->
        <div class="lg:col-span-6 bg-graphite-900 dark:bg-obsidian-950 p-8 sm:p-12 text-white flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-[11px] font-mono tracking-widest text-stone-400 uppercase font-semibold">
              READY TO GET STARTED?
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white">
              Install AFWE in your project
            </h3>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed max-w-md">
              Set up in minutes and give your agents the context they need to work safely and effectively.
            </p>
          </div>

          <div class="pt-8">
            <a 
              href="/docs/getting-started/quick-start" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white text-graphite font-mono text-xs font-bold hover:bg-stone-200 transition-colors shadow-sm"
            >
              <span>View quick start</span>
              <ArrowRight class="size-3.5" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    // 1. Dynamic Hero Tagline Rotation
    const taglines = [
      "Double-entry bookkeeping for autonomous coding.",
      "What Rust did for safer systems, AFWE does for AI coding.",
      "The intent layer that ensures your code matches what it was supposed to be.",
      "Deterministic guardrails that stop architectural drift before commit.",
      "From prompt suggestions to mathematical AST invariants.",
      "What compilers did for type safety, AFWE does for codebase architecture."
    ];

    const taglineEl = document.getElementById('dynamic-hero-tagline');
    if (taglineEl) {
      let currentIndex = Math.floor(Math.random() * taglines.length);
      const textSpan = taglineEl.querySelector('span');
      if (textSpan) {
        textSpan.textContent = taglines[currentIndex];
      }

      taglineEl.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % taglines.length;
        taglineEl.style.opacity = '0';
        setTimeout(() => {
          if (textSpan) {
            textSpan.textContent = taglines[currentIndex];
          }
          taglineEl.style.opacity = '1';
        }, 150);
      });
    }

    // 2. Copy install command script
    const copyBtn = document.getElementById('copy-install-btn');
    const cmdText = document.getElementById('install-cmd-text');
    const copyIconWrap = document.getElementById('copy-icon-wrap');
    const copiedIconWrap = document.getElementById('copied-icon-wrap');

    if (copyBtn && cmdText && copyIconWrap && copiedIconWrap) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cmdText.textContent || 'cargo install afwe');
        copyIconWrap.classList.add('hidden');
        copiedIconWrap.classList.remove('hidden');
        setTimeout(() => {
          copyIconWrap.classList.remove('hidden');
          copiedIconWrap.classList.add('hidden');
        }, 1500);
      });
    }
  </script>
</MarketingLayout>
