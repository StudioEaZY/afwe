---
// roadmap.astro - Phased Roadmap & Community Upvoting
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { BookOpen, Check, Clock, Circle, ChevronUp, ArrowRight } from '@lucide/astro';

// Instant static baseline - 0ms server blocking!
const editorVotes = 1240;
const teamVotes = 892;
const analyticsVotes = 437;

const status = {
  live: { label: 'Live', Icon: Check, text: 'text-emerald-700 dark:text-emerald-400', bar: 'bg-emerald-500' },
  progress: { label: 'In Progress', Icon: Clock, text: 'text-amber-700 dark:text-amber-400', bar: 'bg-amber-500' },
  planned: { label: 'Planned', Icon: Circle, text: 'text-graphite/60 dark:text-stone-400', bar: 'bg-stone-300 dark:bg-obsidian-750' }
};

const promises = [
  'More powerful tooling for real codebases.',
  'A thriving community of builders.',
  'Long-term sustainability without feature gates.'
];

const legend = [
  { key: 'live', label: 'Live', note: 'Available now', color: 'bg-emerald-500' },
  { key: 'progress', label: 'In Progress', note: 'Actively being built', color: 'bg-amber-500' },
  { key: 'planned', label: 'Planned', note: 'Designed, not yet started', color: 'bg-stone-300 dark:bg-obsidian-700' }
];

const phases = [
  {
    n: 'Phase 0', name: 'Foundation', status: 'live', tagline: 'The core AFWE engine.',
    items: ['Core architecture', 'CLI (57 MCP tools)', 'Tree-sitter integration', 'Local documentation', 'Cross-platform support'],
    href: '/docs/concepts/core-concepts'
  },
  {
    n: 'Phase 1', name: 'Studio', status: 'live', tagline: 'Understand your codebase.',
    items: ['Visual Codebase Atlas', 'Components & structure', 'Interactive exploration', 'Search & filters', 'Local customization'],
    href: '/docs'
  },
  {
    n: 'Phase 2', name: 'Governance', status: 'live', tagline: 'Keep your architecture intact.',
    items: ['Constraints as geometry', 'Turn system (begin to commit)', 'Intent verification', 'Tripwires & BLAKE3', 'Probing guides & rubric'],
    href: '/docs/concepts/core-concepts'
  },
  {
    n: 'Phase 3', name: 'Ecosystem', status: 'live', tagline: 'Extend AFWE everywhere.',
    items: ['All 57 MCP tools', 'Editor integrations', 'CI & automation', 'API & SDK architecture', 'Community contributions'],
    href: '/docs/reference/mcp'
  },
  {
    n: 'Phase 4', name: 'Community', status: 'progress', tagline: 'Sustain and grow AFWE.',
    items: ['Sustainer recognition', 'Seat pool system', 'Monthly points (3:1)', 'Roadmap voting', 'Open support knowledge'],
    href: '/pricing'
  },
  {
    n: 'Phase 5+', name: 'Beyond', status: 'planned', tagline: 'A bigger AFWE.',
    items: ['Advanced analytics', 'Enterprise tooling', 'Deeper integrations', 'Global community hub', 'Long-term ecosystem'],
    href: ''
  }
];

const nextUp = [
  { 
    title: 'Sustainer Gate (v1)', status: 'progress', phase: 'Phase 4', pct: 60, href: '/pricing',
    body: 'First-launch recognition experience with customizable display options, opt-out control and reliable fallback.' 
  },
  { 
    title: 'Monthly Points System', status: 'progress', phase: 'Phase 4', pct: 45, href: '/blog/the-sponsored-seat-pool',
    body: 'Baseline points for all users, 3x for sustainers. Used for roadmap votes and community support requests.' 
  },
  { 
    title: 'Expanded Integrations', status: 'planned', phase: 'Phase 5', pct: 20, href: '/docs/reference/mcp',
    body: 'More editor plugins, CI providers and agent platform integrations to make AFWE easier to adopt everywhere.' 
  }
];

const proposals = [
  { id: 'editor-support', title: 'Better editor support', desc: 'VS Code, Cursor, JetBrains plugins', votes: editorVotes },
  { id: 'team-collab', title: 'Team collaboration', desc: 'Shared rule registry & lease sync', votes: teamVotes },
  { id: 'advanced-analytics', title: 'Advanced analytics', desc: 'Architectural drift velocity metrics', votes: analyticsVotes }
];
---

<MarketingLayout
  title="Roadmap · A Clear Path for a Stronger AFWE"
  description="AFWE evolves in phases. Each phase expands the ecosystem while keeping the core experience stable, open, and consistent for everyone."
  activeNav="roadmap"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-20 sm:space-y-28">

    <!-- HERO: Headline + Promises + Status Track -->
    <section class="space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 lg:items-end">
        <div class="lg:col-span-7 space-y-6">
          <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
            ROADMAP & ARCHITECTURE
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-graphite dark:text-white leading-[1.08] tracking-tight">
            A clear path<br />
            <span class="text-survey-600 dark:text-survey-light">for a stronger AFWE.</span>
          </h1>
          <p class="text-base sm:text-lg text-graphite/80 dark:text-stone-300 leading-relaxed font-sans max-w-xl">
            AFWE evolves in phases. Each phase expands the ecosystem while keeping the core experience stable, open, and consistent for everyone.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href="#phases" class="btn btn-primary">Explore what is live</a>
            <a href="/docs" class="btn btn-quiet">
              <BookOpen class="size-4" aria-hidden="true" />
              <span>Read the roadmap guide</span>
            </a>
          </div>
        </div>

        <ul class="lg:col-span-5 border-t border-stone-300 dark:border-obsidian-800 text-sm font-sans text-graphite/80 dark:text-stone-300">
          {promises.map((p) => (
            <li class="flex items-center gap-3 py-3 border-b border-stone-300 dark:border-obsidian-800">
              <span class="size-2 rounded-full bg-survey-600 dark:text-survey-light shrink-0" aria-hidden="true"></span>
              <span class="font-medium">{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Live status strip: one bar per phase, color = status -->
      <div class="rounded-2xl border border-stone-300 dark:border-obsidian-750 bg-white/80 dark:bg-obsidian-900/90 backdrop-blur-xs p-6 sm:p-8 space-y-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
          <span class="font-bold text-graphite dark:text-white uppercase tracking-wider">Current trajectory</span>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-graphite/70 dark:text-stone-400">
            {legend.map((l) => (
              <span class="inline-flex items-center gap-2">
                <span class={`size-2.5 rounded-full ${l.color}`}></span>
                <span class="text-graphite dark:text-stone-200 font-semibold">{l.label}</span>
                <span class="text-graphite/50 dark:text-stone-500">({l.note})</span>
              </span>
            ))}
          </div>
        </div>

        <ol class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 pt-2">
          {phases.map((p) => {
            const st = status[p.status as keyof typeof status] || status.planned;
            return (
              <li class="space-y-2">
                <div class={`h-1.5 w-full rounded-full ${st.bar}`} aria-hidden="true"></div>
                <div class="flex items-baseline justify-between gap-1 font-mono">
                  <span class="text-xs font-bold text-graphite dark:text-white">{p.n}</span>
                  <span class="text-[10px] font-medium text-graphite/60 dark:text-stone-400 capitalize">{p.status}</span>
                </div>
                <p class="text-sm font-bold text-graphite dark:text-stone-200 leading-tight font-sans">{p.name}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- WHAT IS IN EACH PHASE (6 Cards) -->
    <section id="phases" class="space-y-8 scroll-mt-20">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-stone-300 dark:border-obsidian-800 pb-4">
        <div class="space-y-1">
          <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
            PHASES & DELIVERABLES
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
            What is in each phase?
          </h2>
          <p class="text-sm text-graphite/80 dark:text-stone-300 font-sans">A high-level overview of what is included, what is next, and how it all fits together.</p>
        </div>
        <a href="/docs" class="font-mono text-xs font-bold text-survey-600 dark:text-survey-light hover:underline underline-offset-4 inline-flex items-center gap-1">
          <span>View detailed roadmap</span>
          <ArrowRight class="size-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {phases.map((p) => {
          const st = status[p.status as keyof typeof status] || status.planned;
          const StatusIcon = st.Icon;
          return (
            <article class="rounded-2xl border border-stone-300/80 dark:border-obsidian-750 bg-white/70 dark:bg-obsidian-900/70 p-6 flex flex-col justify-between gap-6 shadow-xs">
              <div class="space-y-4">
                <header class="flex items-center justify-between gap-2">
                  <span class="text-xs font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase tracking-wider">{p.n}</span>
                  <span class={`inline-flex items-center gap-1.5 text-xs font-mono font-bold ${st.text}`}>
                    <StatusIcon class="size-3.5" aria-hidden="true" /> {st.label}
                  </span>
                </header>

                <div>
                  <h3 class="text-xl font-bold text-graphite dark:text-white">{p.name}</h3>
                  <p class="text-xs text-graphite/70 dark:text-stone-400 mt-1 font-sans">{p.tagline}</p>
                </div>

                <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-4 border-t border-stone-200 dark:border-obsidian-800">
                  {p.items.map((it) => (
                    <li class="flex items-start gap-2">
                      {p.status === 'live' ? (
                        <Check class="size-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" aria-hidden="true" />
                      ) : (
                        <Circle class="size-2.5 text-graphite/40 dark:text-stone-500 shrink-0 mt-1" aria-hidden="true" />
                      )}
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {p.href && (
                <footer class="pt-4 border-t border-stone-200 dark:border-obsidian-800">
                  <a href={p.href} class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light hover:underline underline-offset-4 inline-flex items-center gap-1">
                    <span>Explore {p.name}</span>
                    <ArrowRight class="size-3" />
                  </a>
                </footer>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- WHAT IS NEXT (Progress Bars) -->
    <section class="space-y-8">
      <div class="space-y-2 max-w-2xl">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          ACTIVE WORK
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
          What is next?
        </h2>
        <p class="text-base text-graphite/80 dark:text-stone-300 font-sans">
          Items currently in development or scheduled for the immediate upcoming release.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {nextUp.map((item) => (
          <article class="rounded-2xl border border-stone-300/80 dark:border-obsidian-750 bg-white/70 dark:bg-obsidian-900/70 p-6 flex flex-col justify-between gap-4 shadow-xs">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-mono">
                <span class="text-graphite/60 dark:text-stone-400 font-bold uppercase">{item.phase}</span>
                <span class="font-bold text-amber-700 dark:text-amber-400">{item.pct}% built</span>
              </div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">{item.title}</h3>
              <p class="text-xs text-graphite/80 dark:text-stone-300 leading-relaxed font-sans">{item.body}</p>
            </div>

            <div class="space-y-3 pt-3 border-t border-stone-200 dark:border-obsidian-800">
              <div class="w-full bg-stone-200 dark:bg-obsidian-800 h-2 rounded-full overflow-hidden">
                <div class="bg-amber-500 h-full rounded-full transition-all duration-500" style={`width: ${item.pct}%`}></div>
              </div>
              {item.href && (
                <a href={item.href} class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light hover:underline underline-offset-4 inline-flex items-center gap-1">
                  <span>Learn more</span>
                  <ArrowRight class="size-3" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- COMMUNITY ROADMAP PROPOSALS & UPVOTING -->
    <section class="space-y-8">
      <div class="space-y-2 max-w-2xl">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          COMMUNITY PROPOSALS
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
          Vote on what comes next.
        </h2>
        <p class="text-base text-graphite/80 dark:text-stone-300 font-sans">
          AFWE roadmap priorities are shaped by community upvoting. All users receive monthly points; sustainers get a 3:1 allocation ratio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {proposals.map((prop) => (
          <div class="rounded-2xl border border-stone-300/80 dark:border-obsidian-750 bg-white/70 dark:bg-obsidian-900/70 p-6 flex flex-col justify-between gap-4 shadow-xs">
            <div class="space-y-2">
              <h3 class="text-lg font-bold text-graphite dark:text-white">{prop.title}</h3>
              <p class="text-xs text-graphite/80 dark:text-stone-300 font-sans">{prop.desc}</p>
            </div>

            <div class="pt-4 border-t border-stone-200 dark:border-obsidian-800 flex items-center justify-between">
              <div class="text-xs font-mono">
                <span class="text-graphite/60 dark:text-stone-400">Total: </span>
                <span id={`votes-${prop.id}`} class="font-bold text-graphite dark:text-white">{prop.votes.toLocaleString()}</span>
                <span class="text-graphite/60 dark:text-stone-400"> points</span>
              </div>
              <button 
                type="button" 
                data-id={prop.id} 
                class="vote-btn btn btn-quiet px-3 py-1.5 text-xs font-mono font-bold inline-flex items-center gap-1.5"
              >
                <ChevronUp class="size-3.5 text-survey-600 dark:text-survey-light" />
                <span>Upvote</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2-TIER CLAIM MODAL (Anonymous Claim Guard) -->
    <div id="claim-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white dark:bg-obsidian-900 p-6 space-y-6 shadow-2xl">
        <div class="space-y-2">
          <div class="text-[10px] font-mono uppercase tracking-widest text-survey-600 dark:text-survey-light font-bold">2-TIER ACCOUNT</div>
          <h3 class="text-xl font-bold text-graphite dark:text-white">Claim your temporary account</h3>
          <p class="text-xs text-graphite/70 dark:text-stone-300 leading-relaxed font-sans">
            To prevent spam and bot distortion, upvoting requires claiming your temporary seat with an email before points are recorded.
          </p>
        </div>

        <form id="claim-form" class="space-y-4">
          <div>
            <label for="claim-email" class="block text-xs font-mono font-bold text-graphite dark:text-stone-200 mb-1">Email address</label>
            <input 
              type="email" 
              id="claim-email" 
              required 
              placeholder="you@domain.com" 
              class="w-full px-3 py-2 rounded-xl border border-stone-300 dark:border-obsidian-700 bg-paper dark:bg-obsidian-950 text-xs font-mono text-graphite dark:text-white focus:outline-none focus:ring-2 focus:ring-survey"
            />
          </div>
          <div class="flex items-center justify-end gap-3 pt-2">
            <button 
              type="button" 
              id="close-claim-btn" 
              class="btn btn-quiet px-4 py-2 text-xs font-mono"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              id="submit-claim-btn" 
              class="btn btn-primary px-4 py-2 text-xs font-mono"
            >
              Claim & Vote
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Lazyload Supabase upvoting & proposal stats in background
    let pendingVoteId: string | null = null;
    const modal = document.getElementById('claim-modal');
    const closeBtn = document.getElementById('close-claim-btn');
    const claimForm = document.getElementById('claim-form') as HTMLFormElement | null;

    document.querySelectorAll<HTMLButtonElement>('.vote-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        if (!id) return;

        const claimed = localStorage.getItem('afwe_claimed_user');
        if (!claimed) {
          pendingVoteId = id;
          modal?.classList.remove('hidden');
        } else {
          castVote(id, claimed);
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      pendingVoteId = null;
    });

    claimForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('claim-email') as HTMLInputElement | null;
      if (!emailInput || !emailInput.value) return;

      localStorage.setItem('afwe_claimed_user', emailInput.value);
      modal?.classList.add('hidden');

      if (pendingVoteId) {
        castVote(pendingVoteId, emailInput.value);
        pendingVoteId = null;
      }
    });

    async function castVote(proposalId: string, email: string) {
      const el = document.getElementById(`votes-${proposalId}`);
      if (el) {
        const current = parseInt(el.textContent?.replace(/,/g, '') || '0', 10);
        el.textContent = (current + 1).toLocaleString();
      }

      try {
        const { supabase } = await import('../lib/supabase');
        await supabase.from('roadmap_votes').insert([{ proposal_id: proposalId, voter_id: email }]);
      } catch (err) {
        // Optimistic UI remains intact
      }
    }

    async function refreshProposalTelemetry() {
      try {
        const { supabase } = await import('../lib/supabase');
        const { data, error } = await supabase
          .from('roadmap_proposals')
          .select('slug, votes');

        if (data && !error) {
          data.forEach((p) => {
            const el = document.getElementById(`votes-${p.slug}`);
            if (el) {
              el.textContent = p.votes.toLocaleString();
            }
          });
        }
      } catch (err) {
        // Static baselines maintain 0ms uninterrupted rendering
      }
    }

    if (document.readyState === 'complete') {
      setTimeout(refreshProposalTelemetry, 150);
    } else {
      window.addEventListener('load', () => setTimeout(refreshProposalTelemetry, 150));
    }
  </script>
</MarketingLayout>
