---
// roadmap.astro - Phased Roadmap & Community Upvoting
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { 
  ArrowRight, 
  BookOpen, 
  Check, 
  Clock, 
  Circle, 
  ChevronUp 
} from '@lucide/astro';

// Instant static baseline - 0ms server blocking!
const editorVotes = 1240;
const teamVotes = 892;
const analyticsVotes = 437;
---

<MarketingLayout
  title="Roadmap · A Clear Path for a Stronger AFWE"
  description="AFWE evolves in phases. Each phase expands the ecosystem while keeping the core experience stable, open, and consistent for everyone."
  activeNav="roadmap"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16">
    <!-- Hero Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          ROADMAP
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-graphite dark:text-white tracking-tight leading-[1.12]">
          A clear path<br />
          <span class="text-survey-600 dark:text-survey-light">for a stronger AFWE.</span>
        </h1>

        <p class="text-base sm:text-lg text-graphite/80 dark:text-stone-300 leading-relaxed font-sans max-w-xl">
          AFWE evolves in phases. Each phase expands the ecosystem while keeping the core experience stable, open, and consistent for everyone.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#phases" 
            class="px-5 py-2.5 rounded-xl bg-graphite hover:bg-stone-800 text-white dark:bg-white dark:text-obsidian-950 dark:hover:bg-stone-200 font-mono text-xs font-bold transition-colors inline-flex items-center gap-2 shadow-xs"
          >
            <span>Explore what is live</span>
            <ArrowRight class="size-3.5" />
          </a>
          <a 
            href="/docs" 
            class="px-5 py-2.5 rounded-xl border border-stone-300 dark:border-obsidian-700 hover:border-graphite text-xs font-mono font-bold text-graphite dark:text-stone-200 inline-flex items-center gap-2 transition-colors"
          >
            <span>Read the roadmap guide</span>
            <BookOpen class="size-3.5" />
          </a>
        </div>
      </div>

      <!-- Right 3D Layer Stack -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="w-full max-w-sm rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-900/50 p-6 space-y-5 shadow-xs">
          <div class="flex justify-center py-2">
            <svg class="w-48 h-40" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M100 20 L160 50 L100 80 L40 50 Z" fill="#758477" fill-opacity="0.15" stroke="#758477" stroke-width="1.5" />
              <path d="M90 45 L100 35 L110 45" stroke="#758477" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M100 60 L160 90 L100 120 L40 90 Z" fill="#292D2B" fill-opacity="0.08" stroke="#292D2B" stroke-width="1.5" />
              <circle cx="100" cy="90" r="6" fill="#292D2B" />
              <path d="M100 100 L160 130 L100 160 L40 130 Z" fill="#C7C4BB" fill-opacity="0.2" stroke="#758477" stroke-width="1.5" />
              <line x1="100" y1="50" x2="100" y2="100" stroke="#758477" stroke-width="1" stroke-dasharray="3 3" opacity="0.6" />
            </svg>
          </div>

          <div class="space-y-3 pt-2 text-xs font-sans">
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-survey-600 mt-1 shrink-0"></span>
              <p class="text-graphite dark:text-stone-300 font-medium">More powerful tooling for real codebases.</p>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-graphite dark:bg-stone-300 mt-1 shrink-0"></span>
              <p class="text-graphite dark:text-stone-300 font-medium">A thriving community of builders.</p>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-stone-400 mt-1 shrink-0"></span>
              <p class="text-graphite dark:text-stone-300 font-medium">Long-term sustainability without feature gates.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Status Legend -->
    <section class="flex flex-wrap items-center justify-center gap-6 py-4 px-6 rounded-2xl border border-stone-200 dark:border-obsidian-800 bg-white/40 dark:bg-obsidian-900/40 text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-emerald-500"></span>
        <span class="font-bold text-graphite dark:text-stone-200">Live</span>
        <span class="text-graphite/60 dark:text-stone-400 text-[11px]">Available now</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-amber-500"></span>
        <span class="font-bold text-graphite dark:text-stone-200">In Progress</span>
        <span class="text-graphite/60 dark:text-stone-400 text-[11px]">Actively being built</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-stone-400"></span>
        <span class="font-bold text-graphite dark:text-stone-200">Planned</span>
        <span class="text-graphite/60 dark:text-stone-400 text-[11px]">Designed, not yet started</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-stone-300 dark:bg-obsidian-700 border border-stone-400"></span>
        <span class="font-bold text-graphite dark:text-stone-200">Exploring</span>
        <span class="text-graphite/60 dark:text-stone-400 text-[11px]">Early research</span>
      </div>
    </section>

    <!-- Horizontal Phase Timeline (0 to 5+) with Lucide Icons -->
    <section class="overflow-x-auto pb-4">
      <div class="min-w-[700px] flex items-center justify-between relative py-6">
        <!-- Connecting Line -->
        <div class="absolute left-6 right-6 top-1/2 -translate-y-1/2 h-0.5 bg-stone-300 dark:bg-obsidian-700 z-0"></div>

        <!-- Phase 0 -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs ring-2 ring-emerald-500">
            <Check class="size-3.5" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 0</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Foundation<br /><span class="font-mono text-emerald-600 font-bold">Live</span></div>
        </div>

        <!-- Phase 1 -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs ring-2 ring-emerald-500">
            <Check class="size-3.5" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 1</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Studio<br /><span class="font-mono text-emerald-600 font-bold">Live</span></div>
        </div>

        <!-- Phase 2 -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs ring-2 ring-emerald-500">
            <Check class="size-3.5" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 2</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Governance<br /><span class="font-mono text-emerald-600 font-bold">Live</span></div>
        </div>

        <!-- Phase 3 -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs ring-2 ring-emerald-500">
            <Check class="size-3.5" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 3</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Ecosystem<br /><span class="font-mono text-emerald-600 font-bold">Live</span></div>
        </div>

        <!-- Phase 4 -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold text-xs ring-2 ring-amber-500 animate-pulse">
            <Clock class="size-3.5" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 4</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Community<br /><span class="font-mono text-amber-600 font-bold">In Progress</span></div>
        </div>

        <!-- Phase 5+ -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-2 bg-paper dark:bg-obsidian-950 px-3">
          <div class="size-7 rounded-full bg-stone-200 dark:bg-obsidian-800 text-graphite/60 dark:text-stone-400 flex items-center justify-center font-bold text-xs ring-1 ring-stone-300">
            <Circle class="size-3" />
          </div>
          <div class="text-xs font-bold text-graphite dark:text-stone-100">Phase 5+</div>
          <div class="text-[10px] text-graphite/70 dark:text-stone-400 font-sans">Beyond<br /><span class="font-mono text-stone-500 font-bold">Planned</span></div>
        </div>
      </div>
    </section>

    <!-- What's in Each Phase Section -->
    <section id="phases" class="space-y-8 scroll-mt-20">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-stone-200 dark:border-obsidian-800 pb-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-graphite dark:text-white tracking-tight">
            What is in each phase?
          </h2>
          <p class="text-xs sm:text-sm text-graphite/70 dark:text-stone-400 font-sans mt-1">
            A high-level overview of what is included, what is next, and how it all fits together.
          </p>
        </div>
        <a 
          href="/docs" 
          class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light hover:underline inline-flex items-center gap-1"
        >
          <span>View detailed roadmap</span>
          <ArrowRight class="size-3" />
        </a>
      </div>

      <!-- 6 Phase Cards Grid with Lucide Checks -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Phase 0: Foundation -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-5 shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 0</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                Live
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Foundation</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">The core AFWE engine.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Core architecture</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> CLI (57 MCP tools)</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Tree-sitter integration</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Local documentation</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Cross-platform support</li>
            </ul>
          </div>
          <a href="/docs/concepts/core-concepts" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-graphite dark:text-stone-200 hover:text-survey-600 dark:hover:text-survey-light pt-2">
            <span>View details</span> <ArrowRight class="size-3" />
          </a>
        </div>

        <!-- Phase 1: Studio -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-5 shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 1</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                Live
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Studio</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">Understand your codebase.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Visual Codebase Atlas</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Components & structure</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Interactive exploration</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Search & filters</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Local customization</li>
            </ul>
          </div>
          <a href="/docs" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-graphite dark:text-stone-200 hover:text-survey-600 dark:hover:text-survey-light pt-2">
            <span>View details</span> <ArrowRight class="size-3" />
          </a>
        </div>

        <!-- Phase 2: Governance -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-5 shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 2</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                Live
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Governance</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">Keep your architecture intact.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Constraints as geometry</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Turn system (begin to commit)</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Intent verification</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Tripwires & BLAKE3</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Probing guides & rubric</li>
            </ul>
          </div>
          <a href="/docs/concepts/core-concepts" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-graphite dark:text-stone-200 hover:text-survey-600 dark:hover:text-survey-light pt-2">
            <span>View details</span> <ArrowRight class="size-3" />
          </a>
        </div>

        <!-- Phase 3: Ecosystem -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-5 shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 3</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                Live
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Ecosystem</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">Extend AFWE everywhere.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> All 57 MCP tools</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Editor integrations</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> CI & automation</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> API & SDK architecture</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-survey-600 shrink-0" /> Community contributions</li>
            </ul>
          </div>
          <a href="/docs/reference/mcp" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-graphite dark:text-stone-200 hover:text-survey-600 dark:hover:text-survey-light pt-2">
            <span>View details</span> <ArrowRight class="size-3" />
          </a>
        </div>

        <!-- Phase 4: Community -->
        <div class="rounded-2xl border-2 border-amber-500/50 bg-white/90 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-5 shadow-sm">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 4</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30">
                In Progress
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Community</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">Sustain and grow AFWE.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Check class="size-3.5 text-amber-600 shrink-0" /> Sustainer recognition</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-amber-600 shrink-0" /> Seat pool system</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-amber-600 shrink-0" /> Monthly points (3:1)</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-amber-600 shrink-0" /> Roadmap voting</li>
              <li class="flex items-center gap-2"><Check class="size-3.5 text-amber-600 shrink-0" /> Open support knowledge</li>
            </ul>
          </div>
          <a href="/pricing" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-amber-600 dark:text-amber-400 hover:underline pt-2">
            <span>View details</span> <ArrowRight class="size-3" />
          </a>
        </div>

        <!-- Phase 5+: Beyond -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-900/50 p-6 flex flex-col justify-between space-y-5 shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold text-graphite/60 dark:text-stone-400 uppercase">PHASE 5+</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-stone-200 dark:bg-obsidian-800 text-graphite/70 dark:text-stone-400">
                Planned
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-graphite dark:text-white">Beyond</h3>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-0.5">A bigger AFWE.</p>
            </div>
            <ul class="space-y-2 text-xs font-sans text-graphite/70 dark:text-stone-400 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2"><Circle class="size-3 text-stone-400 shrink-0" /> Advanced analytics</li>
              <li class="flex items-center gap-2"><Circle class="size-3 text-stone-400 shrink-0" /> Enterprise tooling</li>
              <li class="flex items-center gap-2"><Circle class="size-3 text-stone-400 shrink-0" /> Deeper integrations</li>
              <li class="flex items-center gap-2"><Circle class="size-3 text-stone-400 shrink-0" /> Global community hub</li>
              <li class="flex items-center gap-2"><Circle class="size-3 text-stone-400 shrink-0" /> Long-term ecosystem</li>
            </ul>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-mono text-graphite/50 dark:text-stone-400 pt-2">
            <span>Planned</span>
          </span>
        </div>
      </div>
    </section>

    <!-- What's Next Section -->
    <section class="space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-graphite dark:text-white tracking-tight">
          What is next?
        </h2>
        <p class="text-xs sm:text-sm text-graphite/70 dark:text-stone-400 font-sans mt-1">
          A closer look at the features and systems currently in development.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1. Sustainer Gate (v1) -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 space-y-4 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30">
              IN PROGRESS
            </span>
            <span class="text-[10px] font-mono text-graphite/50 dark:text-stone-400">Phase 4</span>
          </div>

          <div>
            <h3 class="text-base font-bold text-graphite dark:text-white">Sustainer Gate (v1)</h3>
