  <script>
    // Interactive Monthly / Yearly Billing Toggle Script
    const monthlyBtn = document.getElementById('billing-monthly-btn');
    const yearlyBtn = document.getElementById('billing-yearly-btn');
    const priceElements = document.querySelectorAll('.tier-price');
    const periodElements = document.querySelectorAll('.tier-period');

    if (monthlyBtn && yearlyBtn) {
      monthlyBtn.addEventListener('click', () => {
        monthlyBtn.className = 'px-3 py-1.5 rounded-lg bg-graphite text-white dark:bg-white dark:text-graphite font-bold transition-all shadow-xs';
        yearlyBtn.className = 'px-3 py-1.5 rounded-lg text-graphite/70 dark:text-stone-400 hover:text-graphite dark:hover:text-white transition-all flex items-center gap-1.5';
        
        priceElements.forEach(el => {
          el.textContent = el.getAttribute('data-monthly') || '$29';
        });
        periodElements.forEach(el => {
          el.textContent = '/ month';
        });
      });

      yearlyBtn.addEventListener('click', () => {
        yearlyBtn.className = 'px-3 py-1.5 rounded-lg bg-graphite text-white dark:bg-white dark:text-graphite font-bold transition-all shadow-xs flex items-center gap-1.5';
        monthlyBtn.className = 'px-3 py-1.5 rounded-lg text-graphite/70 dark:text-stone-400 hover:text-graphite dark:hover:text-white transition-all';
        
        priceElements.forEach(el => {
          el.textContent = el.getAttribute('data-yearly') || '$290';
        });
        periodElements.forEach(el => {
          el.textContent = '/ year';
        });
      });
    }
  </script>
