---
// pricing.astro - Transparent Open Source Pricing & Community-Sponsored Seat Pool
// Matches user reference mockup (media_1793031172263_9d53d68e.jpg)
// Zero em-dashes throughout all prose and attributes.
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Pricing · Community Seat Pool"
  description="Every developer gets the full AFWE experience: no feature paywalls, no artificial limits. Sustainers fund community seats, accelerate development, and keep AFWE independent."
  activeNav="pricing"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-20">
    <!-- ========================================================================= -->
    <!-- SECTION 1: HERO SECTION                                                   -->
    <!-- ========================================================================= -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Title, Copy, Action Buttons -->
      <div class="lg:col-span-7 space-y-6">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          SUSTAIN AFWE
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-graphite dark:text-white leading-[1.08] tracking-tight">
          Same access.<br />
          <span class="text-graphite/70 dark:text-stone-400">Different impact.</span>
        </h1>

        <p class="text-base sm:text-lg text-graphite/80 dark:text-stone-300 leading-relaxed font-sans max-w-xl">
          Every developer gets the full AFWE experience: no feature paywalls, no artificial limits. Sustainers keep AFWE independent, accelerate development, and help grow the ecosystem.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#tiers" 
            class="px-5 py-3 rounded-lg bg-graphite hover:bg-graphite-900 dark:bg-white dark:hover:bg-stone-100 text-white dark:text-graphite font-mono text-xs font-semibold shadow-sm transition-all"
          >
            Choose a tier ↓
          </a>
          <a 
            href="/blog/the-sponsored-seat-pool" 
            class="px-5 py-3 rounded-lg border border-stone-400 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-850 hover:border-graphite dark:hover:border-stone-400 text-graphite dark:text-stone-200 font-mono text-xs font-semibold shadow-xs transition-all"
          >
            Read the announcement →
          </a>
        </div>
      </div>

      <!-- Right Column: 3D Isometric Tiered Pedestal Graphic -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[420px] aspect-[420/380] select-none">
          <svg viewBox="0 0 420 380" class="w-full h-full overflow-visible" role="img" aria-label="Isometric tiered sustainers illustration">
            <defs>
              <linearGradient id="pedestal-top" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#e2e8e4" stop-opacity="0.8" />
              </linearGradient>
              <linearGradient id="pedestal-side-1" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#a8b5ac" />
                <stop offset="100%" stop-color="#8d9b91" />
              </linearGradient>
              <linearGradient id="pedestal-side-2" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#738077" />
                <stop offset="100%" stop-color="#556058" />
              </linearGradient>
              <linearGradient id="emerald-glow" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#34d399" stop-opacity="0.85" />
                <stop offset="100%" stop-color="#059669" stop-opacity="0.75" />
              </linearGradient>
            </defs>

            <!-- Base Ground Plane (Isometric Grid) -->
            <g stroke="#758477" stroke-opacity="0.22" stroke-width="1" fill="none">
              <path d="M 210 330 L 370 240 L 210 150 L 50 240 Z" />
              <line x1="90" y1="217" x2="250" y2="307" />
              <line x1="130" y1="195" x2="290" y2="285" />
              <line x1="170" y1="172" x2="330" y2="262" />
              <line x1="250" y1="172" x2="90" y2="262" />
              <line x1="290" y1="195" x2="130" y2="285" />
              <line x1="330" y1="217" x2="170" y2="307" />
            </g>

            <!-- Stamped Ground Label -->
            <text x="210" y="362" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="10.5" font-weight="700" letter-spacing="0.18em" fill="#758477" class="dark:fill-stone-400">
              SAME PRODUCT GREATER IMPACT
            </text>

            <!-- Pedestal 1: Base Tier (Normal) -->
            <g transform="translate(110, 190)">
              <!-- Isometric Box 1 -->
              <polygon points="50,0 100,28 50,56 0,28" fill="url(#pedestal-top)" stroke="#c7c4bb" stroke-width="1.2" />
              <polygon points="0,28 50,56 50,86 0,58" fill="url(#pedestal-side-1)" />
              <polygon points="50,56 100,28 100,58 50,86" fill="url(#pedestal-side-2)" />
            </g>

            <!-- Pedestal 2: Mid Tier (Palette) -->
            <g transform="translate(190, 140)">
              <!-- Isometric Box 2 -->
              <polygon points="50,0 100,28 50,56 0,28" fill="url(#pedestal-top)" stroke="#c7c4bb" stroke-width="1.2" />
              <polygon points="0,28 50,56 50,96 0,68" fill="url(#pedestal-side-1)" />
              <polygon points="50,56 100,28 100,68 50,96" fill="url(#pedestal-side-2)" />
            </g>

            <!-- Pedestal 3: Top Tier (Motion with Emerald Glow) -->
            <g transform="translate(230, 70)">
              <!-- Isometric Box 3 -->
              <polygon points="50,0 100,28 50,56 0,28" fill="url(#emerald-glow)" stroke="#6ee7b7" stroke-width="1.5" />
              <polygon points="0,28 50,56 50,116 0,88" fill="#047857" fill-opacity="0.8" />
              <polygon points="50,56 100,28 100,88 50,116" fill="#065f46" fill-opacity="0.9" />
            </g>

            <!-- Leader Lines & Callouts -->
            <!-- Callout 1: Top Tier -> More recognition -->
            <line x1="280" y1="70" x2="350" y2="40" stroke="#758477" stroke-width="1.2" stroke-dasharray="3 3" />
            <circle cx="350" cy="40" r="3" fill="#292D2B" class="dark:fill-white" />
            <text x="360" y="44" font-family="'IBM Plex Sans', sans-serif" font-size="11.5" font-weight="600" fill="#292D2B" class="dark:fill-white">
              More recognition.
            </text>

            <!-- Callout 2: Mid Tier -> More customization -->
            <line x1="240" y1="140" x2="350" y2="105" stroke="#758477" stroke-width="1.2" stroke-dasharray="3 3" />
            <circle cx="350" cy="105" r="3" fill="#758477" />
            <text x="360" y="109" font-family="'IBM Plex Sans', sans-serif" font-size="11.5" font-weight="600" fill="#292D2B" class="dark:fill-white">
              More customization.
            </text>

            <!-- Callout 3: Base Tier -> More influence -->
            <line x1="160" y1="190" x2="350" y2="170" stroke="#758477" stroke-width="1.2" stroke-dasharray="3 3" />
            <circle cx="350" cy="170" r="3" fill="#292D2B" class="dark:fill-white" />
            <text x="360" y="174" font-family="'IBM Plex Sans', sans-serif" font-size="11.5" font-weight="600" fill="#292D2B" class="dark:fill-white">
              More influence.
            </text>
          </svg>
        </div>
      </div>
    </section>

    <!-- 4-Feature Pill Strip -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/70 dark:bg-obsidian-900 p-4 flex items-start gap-3.5 shadow-xs">
        <div class="size-9 rounded-lg bg-stone-200/70 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200 shrink-0 font-bold">
          ❖
        </div>
        <div>
          <div class="font-bold text-xs text-graphite dark:text-white">Full access</div>
          <div class="text-[11px] text-graphite/70 dark:text-stone-400 mt-0.5 leading-relaxed font-sans">
            Same features for everyone
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/70 dark:bg-obsidian-900 p-4 flex items-start gap-3.5 shadow-xs">
        <div class="size-9 rounded-lg bg-stone-200/70 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200 shrink-0 font-bold">
          🎨
        </div>
        <div>
          <div class="font-bold text-xs text-graphite dark:text-white">Customizable support gate</div>
          <div class="text-[11px] text-graphite/70 dark:text-stone-400 mt-0.5 leading-relaxed font-sans">
            Show your name, brand and style
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/70 dark:bg-obsidian-900 p-4 flex items-start gap-3.5 shadow-xs">
        <div class="size-9 rounded-lg bg-stone-200/70 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200 shrink-0 font-bold">
          🛡️
        </div>
        <div>
          <div class="font-bold text-xs text-graphite dark:text-white">Monthly points</div>
          <div class="text-[11px] text-graphite/70 dark:text-stone-400 mt-0.5 leading-relaxed font-sans">
            Support, vote and unlock extras
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/70 dark:bg-obsidian-900 p-4 flex items-start gap-3.5 shadow-xs">
        <div class="size-9 rounded-lg bg-stone-200/70 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200 shrink-0 font-bold">
          🌱
        </div>
        <div>
          <div class="font-bold text-xs text-graphite dark:text-white">Keeps AFWE independent</div>
          <div class="text-[11px] text-graphite/70 dark:text-stone-400 mt-0.5 leading-relaxed font-sans">
            Built by the community, for the community
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: LIVE COMMUNITY SEAT POOL TELEMETRY                             -->
    <!-- ========================================================================= -->
    <section class="rounded-2xl border border-stone-400/80 dark:border-obsidian-700 bg-gradient-to-b from-white/90 to-stone-200/40 dark:from-obsidian-900 dark:to-obsidian-950 p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-stone-300 dark:border-obsidian-800 pb-4">
        <div>
          <div class="text-[10px] font-mono font-bold uppercase tracking-widest text-survey-600 dark:text-survey-light">
            COMMUNITY-SPONSORED SEAT POOL · LIVE METRICS
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-graphite dark:text-white mt-1">
            Free access is funded by community capacity
          </h2>
        </div>
        <div class="flex items-center gap-2 font-mono text-xs text-graphite/80 dark:text-stone-300">
          <span class="size-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Pool Active: 360 open seats</span>
        </div>
      </div>

      <!-- Capacity Progress Bar -->
      <div class="space-y-2">
        <div class="flex items-center justify-between font-mono text-xs">
          <span class="text-graphite/70 dark:text-stone-400">Allocated Capacity: 2,840 / 3,200 seats</span>
          <span class="font-bold text-emerald-700 dark:text-emerald-400">88% Claimed</span>
        </div>
        <div class="w-full h-3.5 rounded-full bg-stone-300 dark:bg-obsidian-800 overflow-hidden p-0.5 border border-stone-400/40 dark:border-obsidian-700">
          <div class="h-full rounded-full bg-gradient-to-r from-survey-500 to-emerald-600 transition-all duration-500" style="width: 88%"></div>
        </div>
        <div class="flex flex-wrap items-center justify-between text-[11px] font-mono text-graphite/60 dark:text-stone-400 pt-1">
          <span>Funded by 42 active sustainers</span>
          <span>360 seats available for new developers</span>
        </div>
      </div>

      <!-- Explanation Card -->
      <div class="rounded-xl border border-stone-300 dark:border-obsidian-800 bg-white/60 dark:bg-obsidian-850 p-4 text-xs font-sans text-graphite/80 dark:text-stone-300 leading-relaxed space-y-2">
        <p>
          <strong>How it works:</strong> When you download AFWE or initialize a project with <code>afwe onboard</code>, you claim an available seat from the community pool. No paywall is placed in your software: everyone runs the exact same code.
        </p>
        <p class="text-[11px] text-graphite/70 dark:text-stone-400">
          If all community-sponsored seats are claimed (0 open seats), website downloads pause until more capacity is sponsored by the community. Developers can always clone and compile directly from the GitHub repository under the MIT License.
        </p>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 3: SUSTAINERS TIERS                                               -->
    <!-- ========================================================================= -->
    <section id="tiers" class="space-y-8 scroll-mt-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-stone-300 dark:border-obsidian-800 pb-6">
        <div>
          <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase mb-2">
            CHOOSE YOUR TIER
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
            Sustainers Tiers
          </h2>
          <p class="text-xs sm:text-sm text-graphite/70 dark:text-stone-400 font-sans max-w-xl mt-1">
            No functionality is locked. Each tier increases your community seat contribution, custom attribution style, and monthly governance points.
          </p>
        </div>

        <!-- Monthly / Yearly Switcher -->
        <div class="flex items-center gap-2 p-1 rounded-xl border border-stone-400/80 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 font-mono text-xs shrink-0 shadow-xs">
          <button 
            id="billing-monthly-btn" 
            class="px-3 py-1.5 rounded-lg bg-graphite text-white dark:bg-white dark:text-graphite font-bold transition-all shadow-xs"
          >
            Monthly
          </button>
          <button 
            id="billing-yearly-btn" 
            class="px-3 py-1.5 rounded-lg text-graphite/70 dark:text-stone-400 hover:text-graphite dark:hover:text-white transition-all flex items-center gap-1.5"
          >
            <span>Yearly</span>
            <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold">2 months free</span>
          </button>
        </div>
      </div>

      <!-- 3 Tier Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <!-- Tier 1: Builder Sustainer -->
        <div class="rounded-3xl border border-stone-400/80 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-graphite/50 transition-all">
          <div class="space-y-5">
            <div>
              <div class="text-xs font-mono font-bold text-graphite/60 dark:text-stone-400">01</div>
              <h3 class="text-xl font-bold text-graphite dark:text-white mt-1">Builder Sustainer</h3>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tier-price" data-monthly="$29" data-yearly="$290">$29</span>
                <span class="text-xs font-mono text-graphite/60 dark:text-stone-400 tier-period">/ month</span>
              </div>
              <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-stone-200/70 dark:bg-obsidian-800 text-[11px] font-mono font-bold text-graphite dark:text-stone-300">
                <span>👥</span>
                <span>50 community seats funded</span>
              </div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans leading-relaxed mt-3">
                A simple way to show your support. Fund 50 seats for fellow developers and set your name, branding and a small logo.
              </p>
            </div>

            <!-- Features Checklist -->
            <ul class="space-y-2.5 font-mono text-xs text-graphite/85 dark:text-stone-300 border-t border-stone-200 dark:border-obsidian-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                <span>Funds 50 developer seats in pool</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                <span>Choose to be shown or remain private</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                <span>Custom name, logo or avatar</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                <span>Standard display style</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                <span>3x monthly governance points</span>
              </li>
            </ul>

            <!-- Live Example Preview Card -->
            <div class="space-y-1.5 pt-2">
              <div class="text-[10px] font-mono uppercase tracking-wider text-graphite/50 dark:text-stone-400 font-bold">
                YOUR DISPLAY (EXAMPLE)
              </div>
              <div class="rounded-xl border border-stone-300 dark:border-obsidian-750 bg-stone-100/70 dark:bg-obsidian-850 p-3 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5 truncate">
                  <div class="size-7 rounded-lg bg-white dark:bg-obsidian-700 border border-stone-300 dark:border-obsidian-600 flex items-center justify-center font-bold text-xs text-graphite dark:text-white">
                    ▲
                  </div>
                  <div class="truncate">
                    <div class="text-xs font-bold text-graphite dark:text-white truncate">Studio Partner</div>
                    <div class="text-[10px] text-graphite/60 dark:text-stone-400">Supporting AFWE</div>
                  </div>
                </div>
                <span class="text-graphite/40 dark:text-stone-500 text-xs">↗</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <a 
              href="https://github.com/sponsors/StudioEaZY" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="block w-full text-center px-4 py-2.5 rounded-xl border border-stone-400 dark:border-obsidian-700 bg-white dark:bg-obsidian-850 hover:border-graphite text-graphite dark:text-stone-200 font-mono text-xs font-bold transition-all shadow-xs"
            >
              Continue with Builder →
            </a>
          </div>
        </div>

        <!-- Tier 2: Studio Sustainer (Highlighted POPULAR) -->
        <div class="rounded-3xl border-2 border-survey-500/90 dark:border-survey-500/70 bg-white/90 dark:bg-obsidian-900 p-6 sm:p-7 flex flex-col justify-between shadow-xl relative scale-102 z-10">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-survey-500 text-white font-mono text-[10px] font-bold tracking-wider uppercase shadow-xs">
            POPULAR
          </div>

          <div class="space-y-5">
            <div>
              <div class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light">02</div>
              <h3 class="text-xl font-bold text-graphite dark:text-white mt-1">Studio Sustainer</h3>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tier-price" data-monthly="$79" data-yearly="$790">$79</span>
                <span class="text-xs font-mono text-graphite/60 dark:text-stone-400 tier-period">/ month</span>
              </div>
              <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-survey-500/15 text-[11px] font-mono font-bold text-survey-700 dark:text-survey-light border border-survey-500/30">
                <span>👥</span>
                <span>150 community seats funded</span>
              </div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans leading-relaxed mt-3">
                More room to express your identity. Fund 150 seats with richer visual colors and styled display across the AFWE experience.
              </p>
            </div>

            <!-- Features Checklist -->
            <ul class="space-y-2.5 font-mono text-xs text-graphite/85 dark:text-stone-300 border-t border-stone-200 dark:border-obsidian-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-survey-500 font-bold">✓</span>
                <span>Funds 150 developer seats in pool</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-survey-500 font-bold">✓</span>
                <span>Everything in Builder</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-survey-500 font-bold">✓</span>
                <span>Custom color palette and borders</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-survey-500 font-bold">✓</span>
                <span>Priority placement in gate rotation</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-survey-500 font-bold">✓</span>
                <span>10x monthly governance points</span>
              </li>
            </ul>

            <!-- Live Example Preview Card -->
            <div class="space-y-1.5 pt-2">
              <div class="text-[10px] font-mono uppercase tracking-wider text-graphite/50 dark:text-stone-400 font-bold">
                YOUR DISPLAY (EXAMPLE)
              </div>
              <div class="rounded-xl border border-survey-600/50 bg-[#243329] text-white p-3 flex items-center justify-between gap-3 shadow-sm">
                <div class="flex items-center gap-2.5 truncate">
                  <div class="size-7 rounded-lg bg-emerald-900 border border-emerald-600 flex items-center justify-center font-bold text-xs text-emerald-300">
                    N
                  </div>
                  <div class="truncate">
                    <div class="text-xs font-bold text-white truncate">Nova Works</div>
                    <div class="text-[10px] text-emerald-300">Sustaining AFWE</div>
                  </div>
                </div>
                <span class="text-emerald-300 text-xs">↗</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <a 
              href="https://github.com/sponsors/StudioEaZY" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="block w-full text-center px-4 py-3 rounded-xl bg-graphite hover:bg-graphite-900 dark:bg-white dark:hover:bg-stone-100 text-white dark:text-graphite font-mono text-xs font-bold transition-all shadow-md"
            >
              Continue with Studio →
            </a>
          </div>
        </div>

        <!-- Tier 3: Patron Sustainer -->
        <div class="rounded-3xl border border-stone-400/80 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-graphite/50 transition-all">
          <div class="space-y-5">
            <div>
              <div class="text-xs font-mono font-bold text-graphite/60 dark:text-stone-400">03</div>
              <h3 class="text-xl font-bold text-graphite dark:text-white mt-1">Patron Sustainer</h3>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tier-price" data-monthly="$199" data-yearly="$1,990">$199</span>
