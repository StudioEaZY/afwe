---
// pricing.astro - 4-Tier Recognition & Community Seat Pool
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { 
  ArrowDownToLine, 
  Eye, 
  Scale, 
  Users, 
  Info, 
  Check, 
  ArrowRight, 
  Code, 
  Building2, 
  Palette as PaletteIcon, 
  Sparkles, 
  Gamepad2, 
  Star, 
  ShieldCheck 
} from '@lucide/astro';

// Instant static baseline - 0ms server blocking!
const baselineAllocation = {
  total_seats: 1000,
  claimed_seats: 5,
  available_seats: 995
};
---

<MarketingLayout
  title="Pricing · The Product is Free. The Recognition is Your Choice"
  description="AFWE's core functionality is open to everyone. Your contribution helps sustain development, unlocks greater recognition options, and gives you a bigger voice in what comes next."
  activeNav="pricing"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16">
    <!-- Hero Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          PRICING
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-graphite dark:text-white tracking-tight leading-[1.12]">
          The product is free.<br />
          <span class="text-survey-600 dark:text-survey-light">The recognition is your choice.</span>
        </h1>

        <p class="text-base sm:text-lg text-graphite/80 dark:text-stone-300 leading-relaxed font-sans max-w-xl">
          AFWE's core functionality is open to everyone. Your contribution helps sustain development, unlocks greater recognition options, and gives you a bigger voice in what comes next.
        </p>

        <!-- 4 Core Feature Pills with Lucide Icons -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
          <div class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-300/80 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-850 text-xs font-mono text-graphite dark:text-stone-200">
            <ArrowDownToLine class="size-3.5 text-survey-600 dark:text-survey-light shrink-0" />
            <span class="text-[11px] font-sans leading-tight">Same access for everyone</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-300/80 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-850 text-xs font-mono text-graphite dark:text-stone-200">
            <Eye class="size-3.5 text-survey-600 dark:text-survey-light shrink-0" />
            <span class="text-[11px] font-sans leading-tight">Transparent availability</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-300/80 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-850 text-xs font-mono text-graphite dark:text-stone-200">
            <Scale class="size-3.5 text-survey-600 dark:text-survey-light shrink-0" />
            <span class="text-[11px] font-sans leading-tight">Fair contribution model</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-300/80 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-850 text-xs font-mono text-graphite dark:text-stone-200">
            <Users class="size-3.5 text-survey-600 dark:text-survey-light shrink-0" />
            <span class="text-[11px] font-sans leading-tight">Open source always</span>
          </div>
        </div>
      </div>

      <!-- Right 3D Stack Illustration -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="w-full max-w-sm rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/50 dark:bg-obsidian-900/50 p-6 space-y-5 shadow-xs">
          <div class="flex justify-center py-2">
            <svg class="w-48 h-40" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Top plane: Intent -->
              <path d="M100 20 L160 50 L100 80 L40 50 Z" fill="#758477" fill-opacity="0.15" stroke="#758477" stroke-width="1.5" />
              <path d="M90 45 L100 35 L110 45" stroke="#758477" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <!-- Middle plane: Implementation -->
              <path d="M100 60 L160 90 L100 120 L40 90 Z" fill="#292D2B" fill-opacity="0.08" stroke="#292D2B" stroke-width="1.5" />
              <rect x="94" y="85" width="12" height="12" rx="2" fill="#292D2B" />
              <!-- Bottom plane: Structure -->
              <path d="M100 100 L160 130 L100 160 L40 130 Z" fill="#C7C4BB" fill-opacity="0.2" stroke="#758477" stroke-width="1.5" />
              <!-- Connecting dashed lines -->
              <line x1="100" y1="50" x2="100" y2="100" stroke="#758477" stroke-width="1" stroke-dasharray="3 3" opacity="0.6" />
            </svg>
          </div>

          <div class="space-y-3 pt-2 text-xs font-sans">
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-survey-600 mt-1 shrink-0"></span>
              <div>
                <span class="font-bold text-graphite dark:text-stone-100">Intent</span>
                <p class="text-[11px] text-graphite/70 dark:text-stone-400">What the code is supposed to be.</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-graphite dark:bg-stone-300 mt-1 shrink-0"></span>
              <div>
                <span class="font-bold text-graphite dark:text-stone-100">Implementation</span>
                <p class="text-[11px] text-graphite/70 dark:text-stone-400">What the code actually does.</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="size-2 rounded-full bg-stone-400 mt-1 shrink-0"></span>
              <div>
                <span class="font-bold text-graphite dark:text-stone-100">Structure</span>
                <p class="text-[11px] text-graphite/70 dark:text-stone-400">How it all fits together and evolves.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Current Allocation Card -->
    <section class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 sm:p-8 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- Metric & Bar -->
        <div class="lg:col-span-5 space-y-3">
          <div class="text-[10px] font-mono font-bold tracking-[0.2em] text-graphite/60 dark:text-stone-400 uppercase">
            CURRENT ALLOCATION
          </div>
          <div class="flex items-center gap-3">
            <span id="allocation-count" class="text-2xl sm:text-3xl font-mono font-bold text-graphite dark:text-white">
              {baselineAllocation.available_seats.toLocaleString()} / {baselineAllocation.total_seats.toLocaleString()} available
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
              Available
            </span>
          </div>
          <!-- Gauge Progress Bar -->
          <div class="w-full h-2 rounded-full bg-stone-200 dark:bg-obsidian-800 overflow-hidden">
            <div 
              id="allocation-bar"
              class="h-full bg-survey-600 dark:bg-survey-light rounded-full transition-all duration-700" 
              style={`width: ${Math.min(100, Math.max(5, (baselineAllocation.available_seats / baselineAllocation.total_seats) * 100))}%`}
            ></div>
          </div>
        </div>

        <!-- Middle Explanatory Text -->
        <div class="lg:col-span-4 text-xs sm:text-sm text-graphite/80 dark:text-stone-300 font-sans leading-relaxed border-t lg:border-t-0 lg:border-l border-stone-200 dark:border-obsidian-800 pt-4 lg:pt-0 lg:pl-6">
          A limited number of seats are currently available for new users. Once they are gone, the <strong class="font-bold text-graphite dark:text-white">free tier will not be accessible from the website</strong>.
        </div>

        <!-- Right MIT GitHub Box with Lucide Info -->
        <div class="lg:col-span-3 text-xs space-y-1.5 border-t lg:border-t-0 lg:border-l border-stone-200 dark:border-obsidian-800 pt-4 lg:pt-0 lg:pl-6">
          <div class="flex items-center gap-1.5 font-bold text-graphite dark:text-stone-200">
            <span>Already have access?</span>
            <Info class="size-3.5 text-graphite/60 dark:text-stone-400" />
          </div>
          <p class="text-[11px] text-graphite/70 dark:text-stone-400">
            You can still use AFWE via the open source repo (MIT License).
          </p>
          <a 
            href="https://github.com/StudioEaZY/afwe" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-graphite dark:text-stone-200 hover:text-survey-600 dark:hover:text-survey-light pt-1"
          >
            <span>View on GitHub</span>
            <ArrowRight class="size-3" />
          </a>
        </div>
      </div>
    </section>

    <!-- Sustainer Tiers Section -->
    <section class="space-y-8">
      <div class="space-y-2">
        <div class="text-[11px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
          SUSTAINER TIERS
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-graphite dark:text-white tracking-tight">
          Choose your level of recognition.
        </h2>
        <p class="text-sm sm:text-base text-graphite/80 dark:text-stone-300 font-sans max-w-2xl leading-relaxed">
          Each tier unlocks more control over how your support is displayed across the AFWE experience. The core product remains the same for everyone.
        </p>
      </div>

      <!-- 4 Columns Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        <!-- 1. Community (FREE) -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-6 shadow-xs">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-bold text-graphite dark:text-white">Community</h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-stone-200 dark:bg-obsidian-800 text-graphite dark:text-stone-300">
                FREE
              </span>
            </div>

            <div>
              <div class="text-sm font-bold text-graphite dark:text-stone-100">Full access. No limits.</div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-1">
                Everything you need to use AFWE, including local customization, and the baseline monthly points.
              </p>
            </div>

            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Full AFWE functionality</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Local customization</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Monthly points (baseline)</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Community support</span>
              </li>
            </ul>
          </div>

          <div class="space-y-4 pt-4 border-t border-stone-200 dark:border-obsidian-800">
            <!-- Supporter Box Preview -->
            <div class="p-3.5 rounded-xl border border-stone-200 dark:border-obsidian-800 bg-paper/60 dark:bg-obsidian-950 space-y-2">
              <div class="flex items-center gap-2.5">
                <div class="size-7 rounded-full bg-stone-300 dark:bg-obsidian-800 flex items-center justify-center font-bold text-xs text-graphite dark:text-stone-200">
                  <Code class="size-3.5" />
                </div>
                <div>
                  <div class="text-xs font-bold text-graphite dark:text-stone-100 leading-none">AFWE</div>
                  <div class="text-[10px] text-graphite/60 dark:text-stone-400 font-mono mt-0.5">Community Member</div>
                </div>
              </div>
              <p class="text-[11px] text-graphite/70 dark:text-stone-400 font-sans italic">
                Open source. Built together.
              </p>
            </div>

            <a 
              href="/docs/getting-started/quick-start" 
              class="w-full py-2.5 px-4 rounded-xl border border-stone-300 dark:border-obsidian-700 hover:border-graphite text-xs font-mono font-bold text-graphite dark:text-stone-200 flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Get started</span>
              <ArrowRight class="size-3" />
            </a>
          </div>
        </div>

        <!-- 2. Presence (TIER 01) -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-6 shadow-xs">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-bold text-graphite dark:text-white">Presence</h3>
                <div class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light mt-0.5">$29/mo · 50 seats</div>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-stone-200 dark:bg-obsidian-800 text-graphite dark:text-stone-300">
                TIER 01
              </span>
            </div>

            <div>
              <div class="text-sm font-bold text-graphite dark:text-stone-100">Be seen. On your terms.</div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-1">
                Control how you are recognized. Choose your name, brand and logo in the AFWE experience.
              </p>
            </div>

            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Everything in Community</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Custom name & logo</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Visibility preferences</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Standard styling options</span>
              </li>
            </ul>
          </div>

          <div class="space-y-4 pt-4 border-t border-stone-200 dark:border-obsidian-800">
            <!-- Supporter Box Preview -->
            <div class="p-3.5 rounded-xl border border-stone-200 dark:border-obsidian-800 bg-paper/60 dark:bg-obsidian-950 space-y-2">
              <div class="flex items-center gap-2.5">
                <div class="size-7 rounded-full bg-survey-600/20 text-survey-700 dark:text-survey-light flex items-center justify-center font-bold text-xs">
                  <Building2 class="size-3.5" />
                </div>
                <div>
                  <div class="text-xs font-bold text-graphite dark:text-stone-100 leading-none">Nova Works</div>
                  <div class="text-[10px] text-graphite/60 dark:text-stone-400 font-mono mt-0.5">Sustaining AFWE</div>
                </div>
              </div>
              <p class="text-[11px] text-graphite/70 dark:text-stone-400 font-sans italic">
                Building better tools, together.
              </p>
            </div>

            <button 
              type="button"
              class="w-full py-2.5 px-4 rounded-xl border border-stone-300 dark:border-obsidian-700 hover:border-graphite text-xs font-mono font-bold text-graphite dark:text-stone-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
              onclick="alert('Presence Tier sponsorship checkout will connect when Phase 4 Community billing launches.')"
            >
              <span>Choose Presence</span>
              <ArrowRight class="size-3" />
            </button>
          </div>
        </div>

        <!-- 3. Palette (TIER 02) [Most Popular] -->
        <div class="rounded-2xl border-2 border-survey-600/70 dark:border-survey-light/60 bg-white/90 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-6 shadow-md relative">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-bold text-graphite dark:text-white">Palette</h3>
                <div class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light mt-0.5">$79/mo · 150 seats</div>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-survey-600 text-white dark:bg-survey-light dark:text-obsidian-950">
                Most popular
              </span>
            </div>

            <div>
              <div class="text-sm font-bold text-graphite dark:text-stone-100">More style. More expression.</div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-1">
                Add your colors and a richer display style to make your support stand out in the AFWE experience.
              </p>
            </div>

            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Everything in Presence</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Custom colors & palette</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Advanced styling options</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Priority in recognition queue</span>
              </li>
            </ul>
          </div>

          <div class="space-y-4 pt-4 border-t border-stone-200 dark:border-obsidian-800">
            <!-- Supporter Box Preview (Warm Tinted) -->
            <div class="p-3.5 rounded-xl border border-survey-600/30 bg-amber-500/10 dark:bg-amber-500/15 space-y-2">
              <div class="flex items-center gap-2.5">
                <div class="size-7 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-300 flex items-center justify-center font-bold text-xs">
                  <PaletteIcon class="size-3.5" />
                </div>
                <div>
                  <div class="text-xs font-bold text-graphite dark:text-stone-100 leading-none">Etheral Labs</div>
                  <div class="text-[10px] text-graphite/60 dark:text-stone-400 font-mono mt-0.5">Sustaining AFWE</div>
                </div>
              </div>
              <p class="text-[11px] text-graphite/70 dark:text-stone-400 font-sans italic">
                Better infrastructure. Brighter futures.
              </p>
            </div>

            <button 
              type="button"
              class="w-full py-2.5 px-4 rounded-xl bg-survey-600 hover:bg-survey-700 text-white dark:bg-survey-light dark:text-obsidian-950 dark:hover:bg-white text-xs font-mono font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-xs"
              onclick="alert('Palette Tier sponsorship checkout will connect when Phase 4 Community billing launches.')"
            >
              <span>Choose Palette</span>
              <ArrowRight class="size-3" />
            </button>
          </div>
        </div>

        <!-- 4. Motion (TIER 03) -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/70 dark:bg-obsidian-900 p-6 flex flex-col justify-between space-y-6 shadow-xs">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-bold text-graphite dark:text-white">Motion</h3>
                <div class="text-xs font-mono font-bold text-survey-600 dark:text-survey-light mt-0.5">$199/mo · 500 seats</div>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-stone-200 dark:bg-obsidian-800 text-graphite dark:text-stone-300">
                TIER 03
              </span>
            </div>

            <div>
              <div class="text-sm font-bold text-graphite dark:text-stone-100">Bring it to life.</div>
              <p class="text-xs text-graphite/70 dark:text-stone-400 font-sans mt-1">
                Add subtle micro-animations and advanced visual treatments for the fullest expression of your support.
              </p>
            </div>

            <ul class="space-y-2 text-xs font-sans text-graphite/80 dark:text-stone-300 pt-2 border-t border-stone-200 dark:border-obsidian-800">
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Everything in Palette</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Micro-animations (AFWE UI)</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Enhanced visual effects</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="size-3.5 text-survey-600 shrink-0" />
                <span>Top-tier recognition placement</span>
              </li>
            </ul>
          </div>

          <div class="space-y-4 pt-4 border-t border-stone-200 dark:border-obsidian-800">
            <!-- Supporter Box Preview -->
            <div class="p-3.5 rounded-xl border border-stone-200 dark:border-obsidian-800 bg-paper/60 dark:bg-obsidian-950 space-y-2 relative overflow-hidden">
              <div class="flex items-center gap-2.5">
                <div class="size-7 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs ring-1 ring-emerald-500/50">
                  <Sparkles class="size-3.5" />
                </div>
                <div>
                  <div class="text-xs font-bold text-graphite dark:text-stone-100 leading-none">Vertex Studio</div>
                  <div class="text-[10px] text-graphite/60 dark:text-stone-400 font-mono mt-0.5">Sustaining AFWE</div>
                </div>
              </div>
              <p class="text-[11px] text-graphite/70 dark:text-stone-400 font-sans italic">
                Ideas. Code. Impact.
              </p>
            </div>

            <button 
              type="button"
              class="w-full py-2.5 px-4 rounded-xl border border-stone-300 dark:border-obsidian-700 hover:border-graphite text-xs font-mono font-bold text-graphite dark:text-stone-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
              onclick="alert('Motion Tier sponsorship checkout will connect when Phase 4 Community billing launches.')"
            >
              <span>Choose Motion</span>
              <ArrowRight class="size-3" />
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- More Than Just A Tier Section with Lucide Icons -->
    <section class="space-y-6 pt-4">
      <div class="text-[10px] font-mono font-bold tracking-[0.2em] text-survey-600 dark:text-survey-light uppercase">
        MORE THAN JUST A TIER
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1. The recognition experience -->
        <div class="rounded-2xl border border-stone-300 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-900 p-6 space-y-3">
          <div class="size-9 rounded-xl bg-stone-200 dark:bg-obsidian-800 flex items-center justify-center text-graphite dark:text-stone-200">
            <Gamepad2 class="size-5 text-survey-600 dark:text-survey-light" />
