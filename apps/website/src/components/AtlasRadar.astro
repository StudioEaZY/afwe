      </div>

      <!-- Exploration Prompt Hint Box -->
      <div class="mt-4 pt-3 border-t border-parchment-300 dark:border-obsidian-700/80">
        <div class="p-2.5 rounded-xl border border-parchment-300 dark:border-obsidian-700 bg-white/60 dark:bg-obsidian-850/60 flex items-center gap-3">
          <span class="text-lg">🧭</span>
          <p class="text-[11px] text-parchment-700 dark:text-obsidian-300 leading-tight">
            <strong>The more you explore, the clearer the picture becomes.</strong> Click any section on the map to inspect its constraints and history.
          </p>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  // Dynamic Node Selection Script
