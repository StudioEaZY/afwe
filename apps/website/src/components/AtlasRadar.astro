---
// AtlasRadar.astro - Architectural Codebase Atlas Sunburst & Navigation System
// Fully accessible, interactive, WCAG AAA/AA compliant cartographic interface
import AfweWordmark from './AfweWordmark.astro';
---

<div class="w-full rounded-2xl border-2 border-parchment-400 dark:border-obsidian-700 bg-gradient-to-b from-[#fbf8f1] to-[#f4eee0] dark:from-[#13161c] dark:to-[#0c0e13] text-parchment-900 dark:text-obsidian-100 shadow-xl overflow-hidden font-sans select-none transition-all">
  <!-- Desktop App Window Chrome Header -->
  <header class="h-14 px-5 border-b border-parchment-300 dark:border-obsidian-700/80 bg-white/70 dark:bg-obsidian-900/80 backdrop-blur flex items-center justify-between gap-4">
    <!-- Brand / Title -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <AfweWordmark class="h-5 w-auto" />
        <span class="hidden sm:inline text-xs text-parchment-600 dark:text-obsidian-400 font-sans pl-2 border-l border-parchment-300 dark:border-obsidian-700">
          Your code. Its memory. Its rules.
        </span>
      </div>
    </div>

    <!-- Telemetry Status Pill -->
    <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full border border-survey-500/30 bg-survey-500/10 text-survey-700 dark:text-survey-light text-xs font-mono font-medium">
      <span class="size-2 rounded-full bg-survey-500 animate-pulse"></span>
      <span>Deterministic Gate Active: 0 drift</span>
    </div>

    <!-- Quick Search Pill Mockup -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-parchment-400 dark:border-obsidian-700 bg-parchment-50 dark:bg-obsidian-850 text-xs text-parchment-600 dark:text-obsidian-400 font-mono shadow-xs">
        <svg class="size-3.5 text-parchment-500 dark:text-obsidian-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden sm:inline">Search code, features, decisions…</span>
        <span class="sm:hidden">Search…</span>
        <kbd class="px-1.5 py-0.5 rounded bg-parchment-200 dark:bg-obsidian-750 text-[10px] text-parchment-800 dark:text-obsidian-300 border border-parchment-300 dark:border-obsidian-650">⌘K</kbd>
      </div>
    </div>
  </header>

  <!-- Main Body Grid: Sidebar + Canvas + Inspector -->
  <div class="flex flex-col lg:flex-row min-h-[760px] divide-y lg:divide-y-0 lg:divide-x divide-parchment-300 dark:divide-obsidian-700/80">
    <!-- Left Navigation Sidebar -->
    <aside class="w-full lg:w-48 shrink-0 bg-[#f5f1e6] dark:bg-obsidian-900/60 p-4 flex flex-col justify-between">
      <div class="space-y-4">
        <!-- Workspace Selector -->
        <div class="pb-3 border-b border-parchment-300 dark:border-obsidian-700/80">
          <div class="text-[10px] font-mono uppercase tracking-wider text-parchment-600 dark:text-obsidian-400 font-bold mb-1">Workspace</div>
          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-parchment-100 dark:bg-obsidian-850 border border-parchment-300 dark:border-obsidian-700 text-xs font-semibold text-parchment-900 dark:text-obsidian-100">
            <span class="truncate">Acme Project</span>
            <svg class="size-3 text-parchment-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="space-y-1 font-sans text-xs">
          <a href="#atlas" class="flex flex-col px-3 py-2 rounded-xl bg-parchment-200/90 dark:bg-obsidian-800 text-parchment-900 dark:text-white font-bold border border-parchment-400/60 dark:border-obsidian-650 shadow-xs">
            <span class="text-[13px] flex items-center gap-2">
              <span class="text-emerald-700 dark:text-emerald-400">❖</span> Atlas
            </span>
            <span class="text-[11px] font-normal text-parchment-600 dark:text-obsidian-400 font-sans">The big picture</span>
          </a>

          <a href="#timeline" class="flex flex-col px-3 py-2 rounded-xl text-parchment-700 dark:text-obsidian-300 hover:bg-parchment-200/50 dark:hover:bg-obsidian-800/50 transition-colors">
            <span class="text-[13px] font-semibold text-parchment-800 dark:text-obsidian-200 flex items-center gap-2">
              <span>⏱</span> Timeline
            </span>
            <span class="text-[11px] text-parchment-600 dark:text-obsidian-400">See the journey</span>
          </a>

          <a href="#turns" class="flex flex-col px-3 py-2 rounded-xl text-parchment-700 dark:text-obsidian-300 hover:bg-parchment-200/50 dark:hover:bg-obsidian-800/50 transition-colors">
            <span class="text-[13px] font-semibold text-parchment-800 dark:text-obsidian-200 flex items-center gap-2">
              <span>🧾</span> Turns
            </span>
            <span class="text-[11px] text-parchment-600 dark:text-obsidian-400">Recent activity</span>
          </a>

          <a href="#blueprint" class="flex flex-col px-3 py-2 rounded-xl text-parchment-700 dark:text-obsidian-300 hover:bg-parchment-200/50 dark:hover:bg-obsidian-800/50 transition-colors">
            <span class="text-[13px] font-semibold text-parchment-800 dark:text-obsidian-200 flex items-center gap-2">
              <span>📐</span> Blueprint
            </span>
            <span class="text-[11px] text-parchment-600 dark:text-obsidian-400">Architecture & rules</span>
          </a>

          <a href="#explorer" class="flex flex-col px-3 py-2 rounded-xl text-parchment-700 dark:text-obsidian-300 hover:bg-parchment-200/50 dark:hover:bg-obsidian-800/50 transition-colors">
            <span class="text-[13px] font-semibold text-parchment-800 dark:text-obsidian-200 flex items-center gap-2">
              <span>🔍</span> Explorer
            </span>
            <span class="text-[11px] text-parchment-600 dark:text-obsidian-400">Search & navigate</span>
          </a>
        </nav>
      </div>

      <!-- Bottom Mountain Landscape Contour & Progress -->
      <div class="mt-8 pt-3 border-t border-parchment-300 dark:border-obsidian-700/80">
        <!-- Mountain etching SVG -->
        <div class="w-full opacity-80 dark:opacity-40">
          <svg viewBox="0 0 184 90" class="w-full h-auto" preserveAspectRatio="none">
            <path d="M0 90V40C30 25 55 35 90 30C125 25 150 18 184 32V90Z" fill="#e9e1ce" class="dark:fill-[#2d3340]" />
            <path d="M0 90V60C35 48 70 56 110 50C140 44 165 48 184 52V90Z" fill="#ded4be" class="dark:fill-[#222733]" />
          </svg>
        </div>

        <div class="mt-2 text-xs font-mono space-y-1">
          <div class="flex items-center gap-1.5 text-parchment-900 dark:text-obsidian-200 font-bold">
            <span class="size-2 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
            <span>82% mapped</span>
          </div>
          <div class="text-[11px] text-parchment-600 dark:text-obsidian-400">
            3 pins · 2 proposals
          </div>
          <div class="text-[10px] text-parchment-500 dark:text-obsidian-500 pt-1">
            AFWE v0.2.0 · Intention-first
          </div>
        </div>
      </div>
    </aside>

    <!-- Center Main Canvas: Header + Radial Graph + Recent Turns -->
    <main class="flex-1 min-w-0 p-5 flex flex-col justify-between overflow-x-auto">
      <div>
        <!-- Canvas Top Bar: Breadcrumb, Heading & Filters -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-3 border-b border-parchment-300 dark:border-obsidian-700/80">
          <div>
            <div class="text-xs font-mono text-parchment-600 dark:text-obsidian-400 mb-1 flex items-center gap-2">
              <span>‹ Atlas</span>
              <span>/</span>
              <span class="rounded px-1.5 py-0.5 bg-parchment-200 dark:bg-obsidian-800 text-parchment-700 dark:text-obsidian-300 text-[10px]">Legacy Project</span>
              <span class="flex items-center gap-1 text-emerald-700 dark:text-emerald-400 text-[10px] font-semibold">
                <span class="size-1.5 rounded-full bg-emerald-600"></span> Partially mapped
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-serif font-bold text-parchment-900 dark:text-white">
              Codebase Atlas
            </h1>
            <p class="text-xs text-parchment-600 dark:text-obsidian-400 mt-0.5">
              Split by folders first, then by which files import each other. Size represents file volume.
            </p>
          </div>

          <!-- Filter Pills & View Mode -->
          <div class="flex items-center gap-2 font-mono text-xs">
            <div class="flex rounded-full border border-parchment-400 dark:border-obsidian-700 p-0.5 bg-parchment-200/60 dark:bg-obsidian-850">
              <button class="px-2.5 py-0.5 rounded-full bg-parchment-900 dark:bg-white text-white dark:text-obsidian-950 font-bold shadow-xs">All</button>
              <button class="px-2.5 py-0.5 rounded-full text-parchment-700 dark:text-obsidian-300 hover:text-black dark:hover:text-white">Mapped</button>
              <button class="px-2.5 py-0.5 rounded-full text-parchment-700 dark:text-obsidian-300 hover:text-black dark:hover:text-white">Inferred</button>
              <button class="px-2.5 py-0.5 rounded-full text-parchment-700 dark:text-obsidian-300 hover:text-black dark:hover:text-white">Unmapped</button>
            </div>
          </div>
        </div>

        <!-- The Central Radial Sunburst SVG Viewport -->
        <div class="relative flex items-center justify-center my-4 py-2">
          <!-- Zoom & Pan Controls (Left) -->
          <div class="absolute left-2 top-4 flex flex-col gap-1 z-20">
            <div class="flex flex-col rounded-lg border border-parchment-400 dark:border-obsidian-700 bg-white/80 dark:bg-obsidian-850/80 backdrop-blur shadow-sm text-xs font-mono">
              <button class="p-2 hover:bg-parchment-200 dark:hover:bg-obsidian-750 text-parchment-800 dark:text-obsidian-200 rounded-t-lg transition-colors" title="Zoom in" aria-label="Zoom in">+</button>
              <button class="p-2 border-t border-parchment-300 dark:border-obsidian-700 hover:bg-parchment-200 dark:hover:bg-obsidian-750 text-parchment-800 dark:text-obsidian-200 transition-colors" title="Zoom out" aria-label="Zoom out">−</button>
              <button class="p-2 border-t border-parchment-300 dark:border-obsidian-700 hover:bg-parchment-200 dark:hover:bg-obsidian-750 text-parchment-800 dark:text-obsidian-200 rounded-b-lg transition-colors" title="Recenter" aria-label="Recenter">⌖</button>
            </div>
          </div>

          <!-- Compass Rose / North Indicator (Bottom Right) -->
          <div class="absolute right-4 bottom-2 hidden sm:flex flex-col items-center gap-0.5 pointer-events-none opacity-60">
            <span class="text-[9px] font-mono font-bold text-parchment-700 dark:text-obsidian-400">N</span>
            <div class="size-4 border border-parchment-500 dark:border-obsidian-500 rounded-full flex items-center justify-center">
              <div class="w-0.5 h-3 bg-parchment-700 dark:text-obsidian-300"></div>
            </div>
          </div>

          <!-- Main SVG Canvas -->
          <svg viewBox="0 0 740 540" class="w-full max-w-[740px] h-auto select-none overflow-visible">
            <defs>
              <!-- Sunburst shadow filter -->
              <filter id="atlas-sh" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="6" stdDeviation="12" flood-color="#5a4a2a" flood-opacity="0.12" />
              </filter>

              <!-- Inferred Amber Pattern -->
              <pattern id="hatch-amber" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#d97706" stroke-width="2" stroke-opacity="0.4" />
              </pattern>

              <!-- Proposals Red Pattern -->
              <pattern id="hatch-red" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#dc2626" stroke-width="2" stroke-opacity="0.4" />
              </pattern>

              <!-- Unmapped Territory Pattern -->
              <pattern id="hatch-slate" width="8" height="8" patternTransform="rotate(-45)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#94a3b8" stroke-width="2" stroke-opacity="0.45" />
              </pattern>

              <!-- Arrow Marker -->
              <marker id="callout-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <circle cx="5" cy="5" r="3" fill="#6b675d" />
              </marker>
            </defs>

            <!-- Radial Background Glow & Concentric Guide Rings -->
            <g class="guide-rings opacity-40 dark:opacity-20 pointer-events-none">
              <circle cx="370" cy="270" r="236" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
              <circle cx="370" cy="270" r="175" fill="none" stroke="currentColor" stroke-width="1" />
              <circle cx="370" cy="270" r="118" fill="none" stroke="currentColor" stroke-width="1" />
              <circle cx="370" cy="270" r="54" fill="none" stroke="currentColor" stroke-width="1" />
            </g>

            <!-- GROUP: Sunburst Geometry with drop shadow -->
            <g filter="url(#atlas-sh)">
              <!-- RING 1 -->

    <g class="cursor-pointer group atlas-sector-btn" data-node="Web" tabindex="0" role="button" aria-label="Web Module, 42 files">
      <path d="M 327.48 163.15 A 115 115 0 0 1 412.52 163.15 L 389.97 219.83 A 54 54 0 0 0 350.03 219.83 Z" 
        fill="#cbe0d3" 
        stroke="#7d9e8b" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="370.00" y="182" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Web</text>
      <text x="370.00" y="195" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">42 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Backend" tabindex="0" role="button" aria-label="Backend Module, 128 files">
      <path d="M 415.49 164.38 A 115 115 0 0 1 475.62 224.51 L 419.60 248.64 A 54 54 0 0 0 391.36 220.40 Z" 
        fill="#bdd9c8" 
        stroke="#15803d" 
        stroke-width="2.5"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 ring-active" 
      />
      <text x="429.40" y="206.6" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Backend</text>
      <text x="429.40" y="219.6" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">128 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Services" tabindex="0" role="button" aria-label="Services Module, 96 files">
      <path d="M 476.85 227.48 A 115 115 0 0 1 476.85 312.52 L 420.17 289.97 A 54 54 0 0 0 420.17 250.03 Z" 
        fill="#ebe6db" 
        stroke="#bcb3a2" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="454.00" y="266" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Services</text>
      <text x="454.00" y="279" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">96 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Data" tabindex="0" role="button" aria-label="Data Module, 64 files">
      <path d="M 475.62 315.49 A 115 115 0 0 1 415.49 375.62 L 391.36 319.60 A 54 54 0 0 0 419.60 291.36 Z" 
        fill="#cbe0d3" 
        stroke="#7d9e8b" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="429.40" y="325.4" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Data</text>
      <text x="429.40" y="338.4" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">64 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Infrastructure" tabindex="0" role="button" aria-label="Infrastructure Module, 41 files">
      <path d="M 412.52 376.85 A 115 115 0 0 1 327.48 376.85 L 350.03 320.17 A 54 54 0 0 0 389.97 320.17 Z" 
        fill="#ebe6db" 
        stroke="#bcb3a2" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="370.00" y="350" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Infrastructure</text>
      <text x="370.00" y="363" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">41 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Shared" tabindex="0" role="button" aria-label="Shared Module, 73 files">
      <path d="M 324.51 375.62 A 115 115 0 0 1 264.38 315.49 L 320.40 291.36 A 54 54 0 0 0 348.64 319.60 Z" 
        fill="#ebe6db" 
        stroke="#bcb3a2" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="310.60" y="325.4" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Shared</text>
      <text x="310.60" y="338.4" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">73 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Core" tabindex="0" role="button" aria-label="Core Module, 118 files">
      <path d="M 263.15 312.52 A 115 115 0 0 1 263.15 227.48 L 319.83 250.03 A 54 54 0 0 0 319.83 289.97 Z" 
        fill="#ebe6db" 
        stroke="#bcb3a2" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="286.00" y="266" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Core</text>
      <text x="286.00" y="279" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">118 files</text>
    </g>
    <g class="cursor-pointer group atlas-sector-btn" data-node="Mobile" tabindex="0" role="button" aria-label="Mobile Module, 37 files">
      <path d="M 264.38 224.51 A 115 115 0 0 1 324.51 164.38 L 348.64 220.40 A 54 54 0 0 0 320.40 248.64 Z" 
        fill="#ebe6db" 
        stroke="#bcb3a2" 
        stroke-width="1.2"
        class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-700 " 
      />
      <text x="310.60" y="206.6" text-anchor="middle" font-size="11" font-weight="600" fill="#1d1c1a" class="pointer-events-none select-none">Mobile</text>
      <text x="310.60" y="219.6" text-anchor="middle" font-size="9" fill="#575043" class="pointer-events-none select-none font-mono">37 files</text>
    </g>

<!-- RING 2 -->

      <g class="cursor-pointer group atlas-sector-btn" data-node="Web" data-sub="views" tabindex="0" role="button" aria-label="Web/views">
        <path d="M 306.40 110.19 A 172 172 0 0 1 334.09 101.79 L 344.95 152.64 A 120 120 0 0 0 325.63 158.50 Z" 
          fill="#cbe0d3" 
          stroke="#7d9e8b" 
          stroke-width="1"
          class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-600" 
        />
        <text x="327.62" y="133.29" text-anchor="middle" font-size="8.5" fill="#3c362c" font-family="'JetBrains Mono', monospace" class="pointer-events-none select-none">views/</text>
      </g>
      <g class="cursor-pointer group atlas-sector-btn" data-node="Web" data-sub="components" tabindex="0" role="button" aria-label="Web/components">
        <path d="M 338.80 100.85 A 172 172 0 0 1 367.60 98.02 L 368.32 150.01 A 120 120 0 0 0 348.23 151.99 Z" 
          fill="#cbe0d3" 
          stroke="#7d9e8b" 
          stroke-width="1"
          class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-600" 
        />
        <text x="355.69" y="127.7" text-anchor="middle" font-size="8.5" fill="#3c362c" font-family="'JetBrains Mono', monospace" class="pointer-events-none select-none">components/</text>
      </g>
      <g class="cursor-pointer group atlas-sector-btn" data-node="Web" data-sub="routes" tabindex="0" role="button" aria-label="Web/routes">
        <path d="M 372.40 98.02 A 172 172 0 0 1 401.20 100.85 L 391.77 151.99 A 120 120 0 0 0 371.68 150.01 Z" 
          fill="#cbe0d3" 
          stroke="#7d9e8b" 
          stroke-width="1"
          class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-600" 
        />
        <text x="384.31" y="127.7" text-anchor="middle" font-size="8.5" fill="#3c362c" font-family="'JetBrains Mono', monospace" class="pointer-events-none select-none">routes/</text>
      </g>
      <g class="cursor-pointer group atlas-sector-btn" data-node="Web" data-sub="styles" tabindex="0" role="button" aria-label="Web/styles">
        <path d="M 405.91 101.79 A 172 172 0 0 1 433.60 110.19 L 414.37 158.50 A 120 120 0 0 0 395.05 152.64 Z" 
          fill="#cbe0d3" 
          stroke="#7d9e8b" 
          stroke-width="1"
          class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-600" 
        />
        <text x="412.38" y="133.29" text-anchor="middle" font-size="8.5" fill="#3c362c" font-family="'JetBrains Mono', monospace" class="pointer-events-none select-none">styles/</text>
      </g>
      <g class="cursor-pointer group atlas-sector-btn" data-node="Backend" data-sub="api" tabindex="0" role="button" aria-label="Backend/api">
        <path d="M 438.03 112.03 A 172 172 0 0 1 463.55 125.67 L 435.27 169.30 A 120 120 0 0 0 417.47 159.79 Z" 
          fill="#cde2d6" 
          stroke="#6c967d" 
          stroke-width="1"
          class="transition-all duration-200 group-hover:brightness-95 group-hover:stroke-emerald-600" 
        />
        <text x="438.82" y="144.24" text-anchor="middle" font-size="8.5" fill="#3c362c" font-family="'JetBrains Mono', monospace" class="pointer-events-none select-none">api/</text>
      </g>
      <g class="cursor-pointer group atlas-sector-btn" data-node="Backend" data-sub="services" tabindex="0" role="button" aria-label="Backend/services">
        <path d="M 467.55 128.34 A 172 172 0 0 1 489.91 146.69 L 453.66 183.97 A 120 120 0 0 0 438.06 171.16 Z" 
          fill="#cde2d6" 
