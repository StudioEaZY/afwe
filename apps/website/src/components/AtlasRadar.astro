      desc: 'Frontend web presentation and client routes.',
      structure: [
        { name: 'web/', count: '42 files', bold: true },
        { name: '↳ views/', count: '18' },
        { name: '↳ components/', count: '14' },
        { name: '↳ routes/', count: '10' }
      ],
      depends: 'Backend, Core',
      mustnot: 'Direct Database access',
      constraint: 'Presentation layer must not invoke SQL or bypass Backend APIs.'
    },
    'Backend': {
      icon: '🗄️',
      badge: 'Mapped',
      desc: 'Core server logic, APIs, and business rules.',
      structure: [
        { name: 'backend/', count: '128 files', bold: true },
        { name: '↳ api/', count: '42' },
        { name: '↳ services/', count: '36' },
        { name: '↳ models/', count: '28' },
        { name: '↳ utils/', count: '22' }
      ],
      depends: 'Database, Shared, Core',
      mustnot: 'UI, Mobile',
      constraint: 'API layer must remain independent of presentation layer.'
    },
    'Services': {
      icon: '⚙️',
      badge: 'Mapped',
      desc: 'Background microservices, auth, billing and integrations.',
      structure: [
        { name: 'services/', count: '96 files', bold: true },
        { name: '↳ auth/', count: '34' },
        { name: '↳ billing/', count: '40' },
        { name: '↳ mailer/', count: '22' }
      ],
      depends: 'Data, Shared',
      mustnot: 'UI Presentation',
      constraint: 'Async workers must process jobs via idempotent queues.'
    },
    'Data': {
      icon: '💾',
      badge: 'Mapped',
      desc: 'Database persistence, migrations, and repository models.',
      structure: [
        { name: 'data/', count: '64 files', bold: true },
        { name: '↳ schema/', count: '20' },
        { name: '↳ repositories/', count: '26' },
        { name: '↳ migrations/', count: '18' }
      ],
      depends: 'Infrastructure',
      mustnot: 'HTTP requests, External APIs',
      constraint: 'All write transactions must pass through schema validations.'
    },
    'Infrastructure': {
      icon: '☁️',
      badge: 'Mapped',
      desc: 'Cloud deployment, containers, CI/CD, and Terraform pipelines.',
      structure: [
        { name: 'infra/', count: '41 files', bold: true },
        { name: '↳ docker/', count: '12' },
        { name: '↳ terraform/', count: '18' },
        { name: '↳ ci/', count: '11' }
      ],
      depends: 'None (Root Foundation)',
      mustnot: 'Application business logic',
      constraint: 'Secrets and credentials must only be injected via KMS tripwires.'
    },
    'Shared': {
      icon: '🔗',
      badge: 'Mapped',
      desc: 'Universal types, pure utilities, and cross-cutting constants.',
      structure: [
        { name: 'shared/', count: '73 files', bold: true },
        { name: '↳ types/', count: '30' },
        { name: '↳ constants/', count: '22' },
        { name: '↳ helpers/', count: '21' }
